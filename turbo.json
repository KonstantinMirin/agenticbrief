{
  "$schema": "https://turborepo.com/schema.json",
  // `packages/**/public-fonts/**` is NOT redundant with `packages/**/src/**`:
  // the self-hosted IBM Plex .woff2 subsets live outside src/, so turbo did not
  // watch them. Demonstrated: appending a byte to a .woff2 and rebuilding
  // returned "6 cached, 6 total >>> FULL TURBO" and served stale artifacts.
  // deploy.sh bypasses turbo (`--workspace=`), but CI or a local re-subset
  // would ship stale fonts.
  "globalDependencies": [
    "data/**",
    "content/**",
    "packages/**/src/**",
    "packages/**/public-fonts/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["src/**", "public/**", "astro.config.mjs", "package.json", "tsconfig.json"]
    },
    // `packages/seo` and `packages/shared-ui` import each other (seo/schema.ts
    // and seo/Seo.astro pull `@agenticbrief/shared-ui/org`; BaseLayout.astro and
    // DocPage.astro pull `@agenticbrief/seo/*`). That package cycle made turbo
    // refuse the whole graph -- `npm run build` and `npm run typecheck` both died
    // with "Cyclic dependency detected: @agenticbrief/seo#build,
    // @agenticbrief/shared-ui#build". Neither package HAS a build script, so the
    // `^build` edge between them is phantom; cutting it on one node breaks the
    // cycle and changes nothing that actually runs. deploy.sh never hit this
    // because it builds each site with `npm run build --workspace=...`.
    "@agenticbrief/seo#build": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
