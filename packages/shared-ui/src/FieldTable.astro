---
/**
 * Schema field reference table.
 *
 * Rendered as a real <table> with a header row because that is what survives
 * text extraction — the format the GEO research repeatedly identifies as the
 * one that gets quoted intact. A definition list or a grid of divs would look
 * similar and extract worse.
 */
import type { SchemaField } from '@agenticbrief/protocol-data/types'

export interface Props {
  fields: SchemaField[]
  caption: string
  /** hide the table behind a <details> when it is long */
  collapseAfter?: number
}

const { fields, caption, collapseAfter = 0 } = Astro.props
const collapsed = collapseAfter > 0 && fields.length > collapseAfter
const required = fields.filter((f) => f.required).length
---

{
  fields.length === 0 ? (
    <p class="muted">
      <em>The published schema declares no fields for this message.</em>
    </p>
  ) : (
    <figure class="comparison">
      {collapsed ? (
        <details>
          <summary>
            {caption} — {fields.length} fields, {required} required
          </summary>
          <table class="field-table">
            <thead>
              <tr>
                <th scope="col">Field</th>
                <th scope="col">Type</th>
                <th scope="col">Required</th>
                <th scope="col">Description</th>
              </tr>
            </thead>
            <tbody>
              {fields.map((f) => (
                <tr>
                  <td>
                    <code>{f.name}</code>
                  </td>
                  <td>{f.type}</td>
                  <td>{f.required ? <span class="badge badge-required">required</span> : ''}</td>
                  <td>
                    {f.description}
                    {f.enumValues && f.enumValues.length > 0 && (
                      <>
                        {f.description ? ' ' : ''}
                        <span class="muted">One of: {f.enumValues.join(', ')}.</span>
                      </>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </details>
      ) : (
        <table class="field-table">
          <caption>
            {caption} — {fields.length} fields, {required} required
          </caption>
          <thead>
            <tr>
              <th scope="col">Field</th>
              <th scope="col">Type</th>
              <th scope="col">Required</th>
              <th scope="col">Description</th>
            </tr>
          </thead>
          <tbody>
            {fields.map((f) => (
              <tr>
                <td>
                  <code>{f.name}</code>
                </td>
                <td>{f.type}</td>
                <td>{f.required ? <span class="badge badge-required">required</span> : ''}</td>
                <td>
                  {f.description}
                  {f.enumValues && f.enumValues.length > 0 && (
                    <>
                      {f.description ? ' ' : ''}
                      <span class="muted">One of: {f.enumValues.join(', ')}.</span>
                    </>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </figure>
  )
}

<style>
  /*
   * §9.5's three token-level refinements, scoped to `.field-table` only so the
   * portfolio's other `<table>` usage (bare markdown tables, ComparisonTable)
   * is untouched by this file. The 390px overflow fix lives in global.css on
   * `main table` — a type selector, so it still matches `.field-table`
   * unchanged; nothing here sets `display`, `width` or `overflow`, so that
   * fix is not shadowed.
   */
  .field-table th,
  .field-table td {
    padding: var(--space-05); /* 16px, ibm.md:156 — was 0.55rem/0.7rem */
  }

  .field-table {
    line-height: var(--lh-ui); /* tables are chrome, not prose (spec ruling 10) */
  }

  .field-table thead th {
    font-size: var(--type-body-short-02-size);
    font-weight: var(--type-body-short-02-weight);
    line-height: var(--type-body-short-02-lh);
    letter-spacing: var(--type-body-short-02-tracking);
  }

  /* Alternating rows, ibm.md:50 — the header band's own `--bg-subtle` sets the
     ceiling for how strong this can read, so data rows alternate between the
     page ground and one step up, never past it. */
  .field-table tbody tr:nth-child(even) {
    background: var(--bg-subtle);
  }
</style>
