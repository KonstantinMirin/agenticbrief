---
/**
 * The single HTML shell for every site in the portfolio.
 *
 * Same shape as the blog's BaseLayout (head -> Header -> main -> Footer) but
 * takes the SEO surface as one props object so a page never assembles meta
 * tags by hand.
 */
import Seo from '@agenticbrief/seo/Seo.astro'
import { ogFileName } from '@agenticbrief/seo/og'
import Header from './Header.astro'
import Footer from './Footer.astro'
import { SITES, siteUrl, type SiteKey } from './sites'
import ibmPlexSansUrl from '@agenticbrief/design-tokens/public-fonts/ibm-plex-sans-var-latin.woff2'
import ibmPlexMonoUrl from '@agenticbrief/design-tokens/public-fonts/ibm-plex-mono-400-latin.woff2'
import ibmPlexSerifUrl from '@agenticbrief/design-tokens/public-fonts/ibm-plex-serif-300-latin.woff2'

/*
 * CSS import order is load-bearing and must not be reordered.
 *
 *   1. design-tokens/index.css — the "Carbon Chassis, No IBM Blue" token
 *      layer. It pulls in tokens.css (the shared `--cds-*` chassis plus the
 *      alias block that defines `--bg`/`--fg`/`--accent`/`--radius`/… ) and
 *      then all six `:root[data-site="…"]` override files.
 *   2. styles/global.css — every element and class rule in the portfolio.
 *      It declares NO custom properties of its own; it only consumes the
 *      ones above.
 *
 * Tokens must be first because global.css reads them. It is also why
 * global.css's former `:root` and `@media (prefers-color-scheme: dark)`
 * `:root` blocks were deleted: if global.css ever regains a `:root` block
 * and lands after this import, the hard-coded values win and per-site
 * theming silently does nothing — no error, just flat output on all six
 * sites (design-research.md §7.7 risk 1, the named quiet-failure mode).
 *
 * The per-site blocks themselves are selected at RUNTIME by the
 * `data-site` attribute on <html> below, not by import order — the same
 * source file is compiled independently by each site's own Astro build, so
 * a conditional per-site import is impossible. `:root[data-site="x"]`
 * (specificity 0,2,0) also beats a bare `:root` (0,1,0) regardless of
 * order, which is the belt to that braces.
 *
 * That attribute is `data-site={site}` on <html> below. Its value is the
 * site's `key` from ./sites.ts and must match a filename under
 * design-tokens/src/sites/ EXACTLY — a mismatch produces no error, just an
 * unthemed page rendered on the package's defensive ink-on-white defaults.
 */
import '@agenticbrief/design-tokens/index.css'
import './styles/global.css'

export interface Props {
  site: SiteKey
  title: string
  description: string
  /** site-relative path of this page, e.g. /tasks/get-products/ */
  path: string
  ogImage?: string
  ogType?: 'website' | 'article'
  publishDate?: Date
  modifiedDate?: Date
  jsonLd?: string
  noindex?: boolean
  keywords?: string[]
  /** nav item to mark active */
  current?: string
  /** render the page at full width, without the prose column */
  wide?: boolean
}

const {
  site,
  title,
  description,
  path,
  ogImage,
  ogType = 'website',
  publishDate,
  modifiedDate,
  jsonLd,
  noindex,
  keywords,
  current,
  wide = false,
} = Astro.props

const def = SITES[site]
const base = siteUrl(site)
const canonical = `${base}${path.startsWith('/') ? path : `/${path}`}`

// Font preload — conditional, keyed on `site` (spec §8.3). Sans is the body
// face on all six sites so it always preloads. The SECOND face preloads only
// where it renders above the fold: Serif on agenticadlab's hub display type,
// Mono on whatisagenticbuying's mono display opener and briefgateway's
// tabular score readout. No site preloads a font it never renders — the
// `@font-face` rules in fonts.css ship to all six either way (inert until
// matched, ~1 KB of CSS — measured, not the spec's "a few hundred bytes")
// but `<link rel="preload">` forces an eager fetch, so over-preloading here
// is a real performance regression, not a safe default.
const preloadMono = site === 'whatisagenticbuying' || site === 'briefgateway'
const preloadSerif = site === 'agenticadlab'

// Per-page card, generated by scripts/og-generator. The blog ships one static
// image site-wide; on a reference site the shared link is usually to a specific
// operation or term, so the card should say which.
//
// noindex pages fall back to the site card: the generator builds from the
// sitemap, and noindex pages are deliberately not in it, so there is no
// per-page card for them to point at.
const resolvedOgImage =
  ogImage ?? (noindex ? `${base}/og-default.png` : `${base}/og/${ogFileName(path)}`)

// Google Publisher Tag, briefgateway only: a leaderboard at the top of every page and a
// rectangle in the content, sold by the Prebid Sales Agent tenant at
// sales.briefgateway.noetis.dev on GAM network 21808260008. The same build is served at
// the productionDomain too, so the tag loads only when the page is on the deployDomain;
// anywhere else the slots stay hidden and nothing is fetched from a third party. The
// other five sites render none of this.
const gptSlots =
  site === 'briefgateway'
    ? {
        leaderboard: {
          id: 'div-gpt-ad-briefgateway-leaderboard',
          path: '/21808260008/briefgateway/briefgateway_leaderboard',
          size: [728, 90],
        },
        rectangle: {
          id: 'div-gpt-ad-briefgateway-rectangle',
          path: '/21808260008/briefgateway/briefgateway_rectangle',
          size: [300, 250],
        },
      }
    : null
const gptHead =
  gptSlots &&
  `if (location.hostname === ${JSON.stringify(def.deployDomain)}) {
  document.documentElement.dataset.gpt = ''
  var gpt = document.createElement('script')
  gpt.async = true
  gpt.src = 'https://securepubads.g.doubleclick.net/tag/js/gpt.js'
  document.head.appendChild(gpt)
  window.googletag = window.googletag || { cmd: [] }
  googletag.cmd.push(function () {
${Object.values(gptSlots)
  .map(
    (s) =>
      `    googletag.defineSlot(${JSON.stringify(s.path)}, ${JSON.stringify(s.size)}, ${JSON.stringify(s.id)}).addService(googletag.pubads())`,
  )
  .join('\n')}
    googletag.pubads().enableSingleRequest()
    googletag.enableServices()
  })
}`
const gptStyle =
  '.ad-slot{display:none;margin:1.5rem auto;max-width:100%;overflow:hidden;text-align:center}' +
  'html[data-gpt] .ad-slot{display:block}'
const gptDisplay = (id: string) =>
  `window.googletag && googletag.cmd.push(function () { googletag.display(${JSON.stringify(id)}) })`
---

<!doctype html>
<html lang="en" data-site={site}>
  <head>
    <link rel="preload" as="font" type="font/woff2" href={ibmPlexSansUrl} crossorigin />
    {
      preloadMono && (
        <link rel="preload" as="font" type="font/woff2" href={ibmPlexMonoUrl} crossorigin />
      )
    }
    {
      preloadSerif && (
        <link rel="preload" as="font" type="font/woff2" href={ibmPlexSerifUrl} crossorigin />
      )
    }
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      siteUrl={base}
      siteName={def.name}
      ogImage={resolvedOgImage}
      ogType={ogType}
      publishDate={publishDate}
      modifiedDate={modifiedDate}
      jsonLd={jsonLd}
      noindex={noindex}
      keywords={keywords}
    />
    {
      gptSlots && (
        <>
          <style is:inline set:html={gptStyle} />
          <script is:inline set:html={gptHead} />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="layout">
      <Header site={site} current={current} />
      {
        gptSlots && (
          <div
            id={gptSlots.leaderboard.id}
            class="ad-slot"
            style={`min-height:${gptSlots.leaderboard.size[1]}px`}
          >
            <script is:inline set:html={gptDisplay(gptSlots.leaderboard.id)} />
          </div>
        )
      }
      <main id="main" class={wide ? 'wide' : 'prose'}>
        <slot />
        {
          gptSlots && (
            <div
              id={gptSlots.rectangle.id}
              class="ad-slot"
              style={`min-height:${gptSlots.rectangle.size[1]}px`}
            >
              <script is:inline set:html={gptDisplay(gptSlots.rectangle.id)} />
            </div>
          )
        }
      </main>
      <Footer site={site} />
    </div>
  </body>
</html>
