---
/**
 * The single HTML shell for every site in the portfolio.
 *
 * Same shape as the blog's BaseLayout (head -> Header -> main -> Footer) but
 * takes the SEO surface as one props object so a page never assembles meta
 * tags by hand.
 */
import Seo from '@agenticbrief/seo/Seo.astro'
import { ogFileName } from '@agenticbrief/seo/og'
import Header from './Header.astro'
import Footer from './Footer.astro'
import { SITES, siteUrl, type SiteKey } from './sites'
import './styles/global.css'

export interface Props {
  site: SiteKey
  title: string
  description: string
  /** site-relative path of this page, e.g. /tasks/get-products/ */
  path: string
  ogImage?: string
  ogType?: 'website' | 'article'
  publishDate?: Date
  modifiedDate?: Date
  jsonLd?: string
  noindex?: boolean
  keywords?: string[]
  /** nav item to mark active */
  current?: string
  /** render the page at full width, without the prose column */
  wide?: boolean
}

const {
  site,
  title,
  description,
  path,
  ogImage,
  ogType = 'website',
  publishDate,
  modifiedDate,
  jsonLd,
  noindex,
  keywords,
  current,
  wide = false,
} = Astro.props

const def = SITES[site]
const base = siteUrl(site)
const canonical = `${base}${path.startsWith('/') ? path : `/${path}`}`

// Per-page card, generated by scripts/og-generator. The blog ships one static
// image site-wide; on a reference site the shared link is usually to a specific
// operation or term, so the card should say which.
//
// noindex pages fall back to the site card: the generator builds from the
// sitemap, and noindex pages are deliberately not in it, so there is no
// per-page card for them to point at.
const resolvedOgImage =
  ogImage ?? (noindex ? `${base}/og-default.png` : `${base}/og/${ogFileName(path)}`)
---

<!doctype html>
<html lang="en">
  <head>
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      siteUrl={base}
      siteName={def.name}
      ogImage={resolvedOgImage}
      ogType={ogType}
      publishDate={publishDate}
      modifiedDate={modifiedDate}
      jsonLd={jsonLd}
      noindex={noindex}
      keywords={keywords}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="layout">
      <Header site={site} current={current} />
      <main id="main" class={wide ? 'wide' : 'prose'}>
        <slot />
      </main>
      <Footer site={site} />
    </div>
  </body>
</html>
