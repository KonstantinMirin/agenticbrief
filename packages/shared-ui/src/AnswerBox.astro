---
/**
 * The answer-first block.
 *
 * Every reference page opens with this. It exists because the GEO research is
 * unambiguous on one point: a short, self-contained definition near the top of
 * the document is what retrieval systems extract and quote. Prose that builds
 * to a definition three paragraphs down does not get cited.
 *
 * Rendered as a <p> inside a semantic container rather than a callout div so
 * that a text-extraction pipeline sees it as the first paragraph of the page.
 */

export interface Props {
  /** the definition or direct answer, ideally under 40 words */
  answer: string
  /** optional label, e.g. the term being defined */
  term?: string
  /** where the definition came from, if spec-derived */
  source?: { label: string; url: string }
}

const { answer, term, source } = Astro.props
const wordCount = answer.trim().split(/\s+/).length
---

<div class="answer-box" data-word-count={wordCount}>
  {term && <p class="answer-term">{term}</p>}
  <p class="answer-text">{answer}</p>
  {
    source && (
      <p class="answer-source">
        Source:{' '}
        <a href={source.url} rel="noopener">
          {source.label}
        </a>
      </p>
    )
  }
</div>

<style>
  /*
   * The six §9.7 ground/radius/shadow/label values already flow entirely from
   * `--answerbox-*` tokens consumed by the shared `.answer-box`/`.answer-term`
   * rules in global.css — this block only completes the two per-site
   * treatments that need a hook global.css does not define, both additive
   * (a fallback keeps the other four sites byte-for-byte unchanged):
   *
   * - adcpexplorer's hairline: the token comment in `sites/adcpexplorer.css`
   *   already says "hairline only, applied as a border, not a shadow", but no
   *   rule ever painted it. `--answerbox-border` closes that gap.
   * - whatisagenticbuying's label is the one treatment that is not "inside
   *   the box" (spec §9.7: "mono 12px/+0.32px eyebrow ABOVE the box") — every
   *   other site's label sits in-flow as the box's first line. Rather than a
   *   `[data-site]` selector (ruled out — variance here stays var()-driven,
   *   same discipline as every other file in this cascade), the box becomes
   *   the positioning context and the term is lifted out of flow only where
   *   a site sets `--answerbox-term-position: absolute`; everywhere else it
   *   defaults to `static` and renders exactly as before.
   */
  .answer-box {
    position: relative;
    border: var(--answerbox-border, none);
  }

  .answer-term {
    position: var(--answerbox-term-position, static);
    bottom: var(--answerbox-term-bottom, auto);
    left: var(--answerbox-term-left, auto);
    /* Falls back to the same label tokens every other site already reads;
       only whatisagenticbuying's file sets the eyebrow pair. */
    font-size: var(--answerbox-eyebrow-size, var(--answerbox-label-size));
    letter-spacing: var(--answerbox-eyebrow-track, var(--answerbox-label-track));
  }
</style>
