---
/**
 * A comparison table.
 *
 * Comparison tables are called out repeatedly in the GEO research as one of the
 * highest-yield formats for citation, because the row/column structure survives
 * text extraction intact. Rendered as a real <table> with scoped headers — not
 * a grid of divs — for exactly that reason.
 */

export interface Props {
  caption: string
  /** first column header, e.g. "Capability" */
  rowHeader: string
  columns: string[]
  rows: { label: string; cells: (string | null)[]; note?: string }[]
  /** text shown in place of a null cell */
  emptyLabel?: string
}

const { caption, rowHeader, columns, rows, emptyLabel = 'Not covered' } = Astro.props
---

<figure class="comparison">
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col">{rowHeader}</th>
        {columns.map((c) => <th scope="col">{c}</th>)}
        {rows.some((r) => r.note) && <th scope="col">Notes</th>}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            {row.cells.map((cell) => (
              <td class={cell === null ? 'cell-empty' : undefined}>{cell ?? emptyLabel}</td>
            ))}
            {rows.some((r) => r.note) && <td class="cell-note">{row.note ?? ''}</td>}
          </tr>
        ))
      }
    </tbody>
  </table>
</figure>

<style>
  /*
   * Same §9.5 refinements as FieldTable, scoped to `.comparison table` (this
   * component has no distinguishing class of its own, unlike `.field-table`,
   * so the wrapper `<figure class="comparison">` is the hook). The row-header
   * column (`th[scope=row]`, global.css) already carries `--bg-subtle`
   * permanently — striping only the `<td>`s keeps that column legible as the
   * header on every row instead of blending into it on alternate rows.
   */
  .comparison table {
    line-height: var(--lh-ui);
  }

  .comparison th,
  .comparison td {
    padding: var(--space-05);
  }

  .comparison thead th {
    font-size: var(--type-body-short-02-size);
    font-weight: var(--type-body-short-02-weight);
    line-height: var(--type-body-short-02-lh);
    letter-spacing: var(--type-body-short-02-tracking);
  }

  .comparison tbody tr:nth-child(even) td {
    background: var(--bg-subtle);
  }
</style>
