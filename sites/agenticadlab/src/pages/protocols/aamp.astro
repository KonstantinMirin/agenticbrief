---
import { getEntry, render } from 'astro:content'
import DocPage from '@agenticbrief/shared-ui/DocPage.astro'
import { siteUrl } from '@agenticbrief/shared-ui/sites'

const entry = await getEntry('guides', 'aamp-what-iab-has-published')
if (!entry) throw new Error('content/guides/aamp-what-iab-has-published.md is missing')
const { Content } = await render(entry)
const BASE = siteUrl('agenticadlab')
---

<DocPage
  site="agenticadlab"
  entry={entry}
  path="/protocols/aamp/"
  technical={false}
  breadcrumbs={[
    { name: 'Agentic Ad Lab', url: `${BASE}/` },
    { name: 'Protocols', url: `${BASE}/protocols/aamp/` },
  ]}
>
  <Content />
</DocPage>
