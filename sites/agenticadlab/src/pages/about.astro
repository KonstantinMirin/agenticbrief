---
import { getEntry, render } from 'astro:content'
import DocPage from '@agenticbrief/shared-ui/DocPage.astro'
import { siteUrl } from '@agenticbrief/shared-ui/sites'

const entry = await getEntry('guides', 'about-agentic-ad-lab')
if (!entry) throw new Error('content/guides/about-agentic-ad-lab.md is missing')
const { Content } = await render(entry)
const BASE = siteUrl('agenticadlab')
---

<DocPage
  site="agenticadlab"
  entry={entry}
  path="/about/"
  technical={false}
  breadcrumbs={[
    { name: 'Agentic Ad Lab', url: `${BASE}/` },
    { name: 'About', url: `${BASE}/about/` },
  ]}
>
  <Content />
</DocPage>
