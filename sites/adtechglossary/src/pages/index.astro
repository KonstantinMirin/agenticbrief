---
import { getCollection } from 'astro:content'
import BaseLayout from '@agenticbrief/shared-ui/BaseLayout.astro'
import AnswerBox from '@agenticbrief/shared-ui/AnswerBox.astro'
import FaqBlock from '@agenticbrief/shared-ui/FaqBlock.astro'
import GlossaryChrome from '../components/GlossaryChrome.astro'
import { publishedOnly } from '@agenticbrief/content-utils'
import {
  graph,
  organizationNode,
  personNode,
  webSiteNode,
  webPageNode,
  articleNode,
  faqPageNode,
  definedTermSetNode,
} from '@agenticbrief/seo/schema'
import { siteUrl } from '@agenticbrief/shared-ui/sites'
import { SECTIONS, sectionFor } from '../lib/sections'

const BASE = siteUrl('adtechglossary')
const HUB = siteUrl('agenticadlab')

const entries = publishedOnly(await getCollection('glossary')).sort((a, b) =>
  a.data.term.localeCompare(b.data.term),
)

// The about section is sourcing, not vocabulary: it is excluded from the term
// count and from the A-Z, and reached from the Related list instead.
const termEntries = entries.filter((e) => sectionFor(e.id) !== 'about')

const bySection = new Map<string, typeof entries>()
for (const entry of termEntries) {
  const key = sectionFor(entry.id)
  bySection.set(key, [...(bySection.get(key) ?? []), entry])
}

// A-Z index (design brief §6.1, F3): the corpus's 35 terms occupy 13 of 26
// letters, so a single sticky rail plus a flowing alphabetical run replaces
// Investopedia's per-letter pages, which this data cannot support. The 13
// dead letters are shown, not hidden — a reader who looks for R learns
// there is no R, and that is what makes the rail read as an alphabet
// rather than a tag cloud.
const ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('')
const byLetter = new Map<string, typeof termEntries>()
for (const entry of termEntries) {
  const letter = entry.data.term[0].toUpperCase()
  byLetter.set(letter, [...(byLetter.get(letter) ?? []), entry])
}
const letterHref = (letter: string) => `az-${letter.toLowerCase()}`

// published = earliest pubDate; modified = latest updatedDate.
const published = new Date(Math.min(...entries.map((e) => e.data.pubDate.getTime()))).toISOString()
const modified = new Date(
  Math.max(...entries.map((e) => (e.data.updatedDate ?? e.data.pubDate).getTime())),
).toISOString()

const answer = `The Ad Tech Glossary defines ${termEntries.length} terms from the two agentic advertising protocol stacks — AdCP, from AgenticAdvertising.org, and AAMP, from IAB Tech Lab — and gives each term its counterpart in the other stack, or records that it has none.`

const faq = [
  {
    question: 'What does AAMP stand for?',
    answer:
      "IAB Tech Lab's hub README expands AAMP as Agentic Advertising Management Protocols. Repositories under the same label use other expansions of the same acronym for the same set of repositories, among them Agentic Advertising Marketplace Protocol in shipped source.",
  },
  {
    question: 'Do AdCP and AAMP use the same words for the same things?',
    answer:
      'The two stacks do not share a vocabulary. AdCP says sales agent and AAMP says seller agent for the same role, so the names alone do not reveal that it is one role. Package is the harder case, because both stacks use it: in AdCP a package is a line item inside a media buy that already exists, and in AAMP it is a bundle a seller advertises in a media kit before anything has been bought.',
  },
]

const url = `${BASE}/`
const title = 'Agentic advertising glossary — AdCP and AAMP terms defined'
const description = `${termEntries.length} terms in agentic advertising, defined from the AdCP and AAMP specifications: agent roles, buying objects, signals, real-time execution, negotiation and governance.`

const jsonLd = graph([
  organizationNode(),
  personNode(),
  webSiteNode({ siteUrl: BASE, name: 'Ad Tech Glossary', description }),
  webPageNode({ url, siteUrl: BASE, title, description }),
  definedTermSetNode({
    url,
    name: 'Ad Tech Glossary — agentic advertising terms',
    description,
  }),
  articleNode({
    url,
    title,
    description,
    datePublished: published,
    dateModified: modified,
    technical: true,
    keywords: ['agentic advertising glossary', 'ad tech glossary', 'adcp terms', 'aamp terms'],
  }),
  faqPageNode(url, faq),
])
---

<BaseLayout
  site="adtechglossary"
  title={title}
  description={description}
  path="/"
  jsonLd={jsonLd}
  wide
  keywords={['agentic advertising glossary', 'ad tech glossary', 'adcp glossary']}
>
  <GlossaryChrome />

  {
    /*
    THE SHEET ON THE DESK — homepage composition.

    The masthead is the only block that sits directly on the #f4f4f4 desk:
    title, the one-sentence definition of the whole corpus at lead size, and
    the orientation paragraph. Its h1 hairline runs the full 1180px, so the
    page opens on an architectural rule rather than a hero.

    Everything below it — the letter rail, the A-Z index and the systematic
    contents — is ONE continuous #ffffff sheet. Zero border, zero shadow,
    zero radius: the value jump is the edge. The book, opened on the desk.

    No copy is added or reworded anywhere in this pass; only the wrappers
    and their classes are new.
  */
  }
  <header class="masthead">
    <h1>Ad Tech Glossary</h1>

    <AnswerBox answer={answer} />

    <p>
      AdCP, the Ad Context Protocol, is a registry of named operations and JSON schemas for buying
      and selling media through agents, published by AgenticAdvertising.org. AAMP is IAB Tech Lab's
      umbrella over its agentic work — nine repositories, eight of them with published code —
      covering the same ground plus real-time bidding and audience embeddings. Each stack names a
      buy-side agent and a sell-side agent, and one word can name different objects in each. The
      entries for <a href="/concepts/adcp/">AdCP</a>, <a href="/concepts/aamp/">AAMP</a> and <a
        href="/media-buying/package/">Package</a
      > carry the distinctions the rest of the glossary refers back to.
    </p>
  </header>

  <div class="sheet">
    <nav class="az-rail" aria-label="Jump to letter">
      {
        ALPHABET.map((letter) =>
          byLetter.has(letter) ? (
            <a href={`#${letterHref(letter)}`}>{letter}</a>
          ) : (
            <span>{letter}</span>
          ),
        )
      }
    </nav>

    <div class="az-index">
      {
        ALPHABET.filter((letter) => byLetter.has(letter)).map((letter) => (
          <div class="az-group">
            <h2 class="az-letter" id={letterHref(letter)}>
              {letter}
            </h2>
            <ul class="az-run">
              {byLetter.get(letter)!.map((e) => (
                <li>
                  <a href={`/${sectionFor(e.id)}/${e.id}/`}>{e.data.term}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {
      /*
      The systematic contents. This used to be eight identically-stacked
      heading + paragraph + list blocks, which is slop tell 3 (the equal-
      weight tile run) wearing a list instead of a card. Recomposed as a
      printed contents spread: the section name and its scope statement hold
      a narrow left column, the terms it contains run in the wide right one,
      and one hairline per entry spans the whole sheet. Asymmetric by row,
      not by page — lookup speed is untouched (editorial-references §3, axis
      7's warning against asymmetric PAGE layout on reference sites).
    */
    }
    <div class="contents">
      {
        Object.entries(SECTIONS).map(([key, meta]) => {
          const list = bySection.get(key) ?? []
          if (list.length === 0) return null
          return (
            <section>
              <div class="contents-head">
                <h2 id={key}>
                  <a href={`/${key}/`}>{meta.title}</a>
                </h2>
                <p>{meta.summary}</p>
              </div>
              <ul class="term-list">
                {list.map((e) => (
                  <li>
                    <a class="term-name" href={`/${key}/${e.id}/`}>
                      {e.data.term}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        })
      }
    </div>

    <FaqBlock entries={faq} />

    <h2>Related</h2>
    <ul>
      <li>
        <a href={`${HUB}/protocols/adcp-vs-aamp/`} rel="noopener">AdCP compared with AAMP</a> — the architecture
        underneath the terminology
      </li>
      <li><a href="https://adcpexplorer.com/" rel="noopener">AdCP Explorer</a></li>
      <li><a href="https://aampexplorer.com/" rel="noopener">AAMP Explorer</a></li>
      <li>
        <a href="/about/sources-and-versions/">Sources and versions</a> — which specification artifact
        each definition comes from, and the terms this glossary leaves out on purpose
      </li>
    </ul>
  </div>
</BaseLayout>
