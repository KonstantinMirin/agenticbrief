---
/**
 * One page per glossary term.
 *
 * DefinedTerm + inDefinedTermSet is the schema.org markup for a glossary: it
 * hands a retrieval pipeline the term and its definition without making it
 * parse prose.
 */
import { getCollection, render } from 'astro:content'
import PageLayout from '@agenticbrief/shared-ui/PageLayout.astro'
import { publishedOnly } from '@agenticbrief/content-utils'
import {
  graph,
  organizationNode,
  personNode,
  webSiteNode,
  webPageNode,
  articleNode,
  breadcrumbNode,
  definedTermNode,
  definedTermSetNode,
} from '@agenticbrief/seo/schema'
import { SITES, siteUrl } from '@agenticbrief/shared-ui/sites'
import { SECTIONS, sectionFor } from '../../lib/sections'

const BASE = siteUrl('adtechglossary')

export async function getStaticPaths() {
  const entries = publishedOnly(await getCollection('glossary'))
  return entries.map((entry) => ({
    params: { section: sectionFor(entry.id), slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const section = sectionFor(entry.id)
const sectionMeta = SECTIONS[section as keyof typeof SECTIONS]

const path = `/${section}/${entry.id}/`
const url = `${BASE}${path}`
const termsetUrl = `${BASE}/`

const breadcrumbs = [
  { name: 'Ad Tech Glossary', url: termsetUrl },
  ...(sectionMeta ? [{ name: sectionMeta.title, url: `${BASE}/${section}/` }] : []),
  { name: entry.data.term, url },
]

const jsonLd = graph([
  organizationNode(),
  personNode(),
  webSiteNode({ siteUrl: BASE, name: 'Ad Tech Glossary', description: entry.data.description }),
  webPageNode({
    url,
    siteUrl: BASE,
    title: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.pubDate.toISOString(),
    dateModified: (entry.data.updatedDate ?? entry.data.pubDate).toISOString(),
    breadcrumb: {},
  }),
  breadcrumbNode(url, breadcrumbs),
  definedTermSetNode({
    url: termsetUrl,
    name: 'Ad Tech Glossary — agentic advertising terms',
    description:
      'Agentic advertising terms defined from the AdCP and AAMP specifications: agent roles, buying objects, signals, real-time execution, negotiation and governance.',
  }),
  // The about section is sourcing, not vocabulary, so it is not marked up as a
  // term in the set.
  ...(section === 'about'
    ? []
    : [
        definedTermNode({
          url,
          term: entry.data.term,
          definition: entry.data.answer,
          termSetUrl: termsetUrl,
          alternateNames: entry.data.alternateNames,
        }),
      ]),
  articleNode({
    url,
    title: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.pubDate.toISOString(),
    dateModified: (entry.data.updatedDate ?? entry.data.pubDate).toISOString(),
    technical: true,
    section: sectionMeta?.title,
    keywords: entry.data.keywords,
    citations: entry.data.citations,
  }),
])

// related[] is authored as paths or absolute URLs. Resolve internal links to
// the term title and external ones to the destination site and page, so no
// anchor renders as a bare URL.
const all = publishedOnly(await getCollection('glossary'))
const titleBySlug = new Map(all.map((e) => [e.id, e.data.term]))

const siteNameByDomain = new Map<string, string>(
  Object.values(SITES).flatMap((s) => [
    [s.deployDomain, s.name] as [string, string],
    [s.productionDomain, s.name] as [string, string],
  ]),
)

// Slug words that are names rather than words.
const CASED: Record<string, string> = {
  adcp: 'AdCP',
  aamp: 'AAMP',
  artf: 'ARTF',
  rtb: 'RTB',
  mcp: 'MCP',
  a2a: 'A2A',
  si: 'SI',
  tmp: 'TMP',
  api: 'API',
  iab: 'IAB',
  openrtb: 'OpenRTB',
  opendirect: 'OpenDirect',
  json: 'JSON',
}

function externalLink(href: string): { href: string; title: string; note?: string } {
  const target = new URL(href)
  const name = siteNameByDomain.get(target.hostname)
  if (!name) return { href, title: `${target.hostname}${target.pathname}` }
  const segments = target.pathname.split('/').filter(Boolean)
  if (segments.length === 0) return { href, title: name }
  const words = segments[segments.length - 1].split('-').map((w) => CASED[w] ?? w)
  const note = words.join(' ').replace(/^./, (c) => c.toUpperCase())
  return { href, title: name, note }
}

// An internal link whose target is not published is dropped rather than
// rendered as a 404. The reference stays in frontmatter and starts working the
// moment that term ships, and the build warns so the gap stays visible.
const related = entry.data.related
  .map((href) => {
    const isExternal = /^https?:\/\//.test(href)
    if (isExternal) return externalLink(href)
    const segments = href.split('/').filter(Boolean)
    if (segments.length === 0) return { href, title: 'Ad Tech Glossary' }
    if (segments.length === 1) {
      const meta = SECTIONS[segments[0] as keyof typeof SECTIONS]
      if (meta) return { href, title: meta.title }
    }
    const term = titleBySlug.get(segments[segments.length - 1])
    if (!term) {
      console.warn(`[adtechglossary] ${entry.id}: related link "${href}" has no published target`)
      return null
    }
    return { href, title: term }
  })
  .filter((l): l is { href: string; title: string; note?: string } => l !== null)
---

<PageLayout
  site="adtechglossary"
  title={entry.data.title}
  heading={entry.data.term}
  description={entry.data.description}
  path={path}
  answer={entry.data.answer}
  breadcrumbs={breadcrumbs}
  related={related}
  jsonLd={jsonLd}
  ogType="article"
  publishDate={entry.data.pubDate}
  modifiedDate={entry.data.updatedDate ?? entry.data.pubDate}
  keywords={entry.data.keywords}
>
  <Content />
</PageLayout>
