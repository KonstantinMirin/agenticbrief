---
import BaseLayout from '@agenticbrief/shared-ui/BaseLayout.astro'
import AnswerBox from '@agenticbrief/shared-ui/AnswerBox.astro'
import SpecSource from '@agenticbrief/shared-ui/SpecSource.astro'
import FaqBlock from '@agenticbrief/shared-ui/FaqBlock.astro'
import { aamp } from '@agenticbrief/protocol-data'
import {
  graph,
  organizationNode,
  personNode,
  webSiteNode,
  webPageNode,
  articleNode,
  faqPageNode,
} from '@agenticbrief/seo/schema'
import { BASE, HUB, ADCP_SITE, MATURITY, componentsByMaturity, editorialGaps } from '../lib/site'

const components = componentsByMaturity()
const substantial = components.filter((c) => MATURITY[c.name]?.level === 'substantial')
const gaps = editorialGaps()

const answer =
  'AAMP is IAB Tech Lab’s umbrella for agentic advertising work. It is not one protocol: it is eight independently versioned repositories spanning a control plane built on OpenDirect 2.1, a serve-time bidstream framework, and an embedding-exchange data plane.'

const faq = [
  {
    question: 'What version is AAMP?',
    answer:
      'There is no single AAMP version. Each repository versions independently — the seller agent is at v2.4.1, the real-time framework at v1.0, and the audiences specification is untagged. A press-release version number for AAMP as a whole does not correspond to any one artifact.',
  },
  {
    question: 'What does AAMP stand for?',
    answer:
      'The hub README says Agentic Advertising Management Protocols. The seller agent’s architecture documentation says IAB Agent & API Management Protocol, and guides in both reference agents say Agent-to-Agent Marketplace Protocol. Three expansions coexist in one corpus.',
  },
  {
    question: 'Is AAMP a specification or a set of reference implementations?',
    answer:
      'Both, unevenly. The real-time framework and the shared wire contract are specifications. The buyer and seller agents are working applications whose documentation is the closest thing to a control-plane specification. Two repositories define nothing normative at all.',
  },
  {
    question: 'How does AAMP relate to AdCP?',
    answer:
      'Nothing in the AAMP repositories references AdCP. Searching all eight repositories for AdCP returns no substantive match, so any comparison between the two is made from outside both, not from a mapping either side publishes.',
  },
]

const url = `${BASE}/`
const title = 'AAMP Explorer — what IAB Tech Lab’s agentic protocols actually contain'
const description =
  'An honest map of AAMP: eight IAB Tech Lab repositories across three planes, what each one actually defines, what version it is at, and where the specification has holes.'

const jsonLd = graph([
  organizationNode(),
  personNode(),
  webSiteNode({ siteUrl: BASE, name: 'AAMP Explorer', description }),
  webPageNode({ url, siteUrl: BASE, title, description }),
  articleNode({
    url,
    title,
    description,
    datePublished: '2026-08-08',
    technical: true,
    proficiencyLevel: 'Expert',
    keywords: ['aamp', 'iab tech lab aamp', 'agentic advertising management protocols', 'artf'],
    citations: [aamp.homepage, aamp.repository],
  }),
  faqPageNode(url, faq),
])
---

<BaseLayout
  site="aampexplorer"
  title={title}
  description={description}
  path="/"
  jsonLd={jsonLd}
  wide
  keywords={['aamp', 'iab tech lab aamp', 'agentic advertising management protocols']}
>
  <h1>AAMP Explorer</h1>

  <AnswerBox answer={answer} term="AAMP" />

  <p>
    This site is generated by reading all eight repositories directly. Where a component is
    substantial it gets a full reference; where it is a stub, this site says so. That distinction is
    the thing the official hub page does not make, and it is the difference between a map and a
    brochure.
  </p>

  <h2>What version is AAMP?</h2>

  <p>
    There is no answer to that question, and the honest form of this site has to say so. Each
    repository carries its own semantic version, and the hub states this as policy: <q
      >Each repository uses independent semantic versioning.</q
    > A single AAMP version number quoted anywhere is a marketing artifact, not something you can resolve
    to a schema.
  </p>

  <table>
    <caption>AAMP components at the commits this site was generated from</caption>
    <thead>
      <tr>
        <th scope="col">Component</th>
        <th scope="col">Version</th>
        <th scope="col">Kind</th>
        <th scope="col">Substance</th>
      </tr>
    </thead>
    <tbody>
      {
        components.map((c) => (
          <tr>
            <th scope="row">
              <a href={`/repos/${c.name}/`}>{c.name}</a>
            </th>
            <td>
              <code>{c.version}</code>
            </td>
            <td>{c.kind.replace(/-/g, ' ')}</td>
            <td>
              <span class="badge">{MATURITY[c.name]?.level ?? 'unassessed'}</span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <h2>What are AAMP's three planes?</h2>

  <p>
    The components do not compose into one stack. They occupy three planes that share no common type
    — there is no file anywhere in the corpus that maps a real-time deal identifier to a
    control-plane deal object, or an audience embedding to a buyer-side segment.
  </p>

  <dl>
    {
      aamp.layers.map((layer) => (
        <div class="faq-item">
          <dt>{layer.title}</dt>
          <dd>{layer.description}</dd>
        </div>
      ))
    }
  </dl>

  <h2>Which components carry real specification?</h2>

  <ul>
    {
      substantial.map((c) => (
        <li>
          <a href={`/repos/${c.name}/`}>
            <strong>{c.name}</strong>
          </a>{' '}
          — {MATURITY[c.name].note}
        </li>
      ))
    }
  </ul>

  <h2>Where are the gaps?</h2>

  <p>
    These were found by reading the repositories, not by reading about them. Each one is checkable
    against the commit named at the bottom of this page.
  </p>

  <ul>
    {gaps.map((g) => <li>{g}</li>)}
  </ul>

  <FaqBlock entries={faq} />

  <h2>Related</h2>
  <ul>
    <li>
      <a href={`${HUB}/protocols/adcp-vs-aamp/`} rel="noopener">AdCP compared with AAMP</a> — the two
      stacks side by side
    </li>
    <li>
      <a href={ADCP_SITE} rel="noopener">AdCP Explorer</a> — the same treatment for the other camp
    </li>
    <li><a href="/repos/">Every AAMP component in detail</a></li>
  </ul>

  <SpecSource provenance={aamp.provenance} />
</BaseLayout>
