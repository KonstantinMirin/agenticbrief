---
import PageLayout from '@agenticbrief/shared-ui/PageLayout.astro'
import AnswerBox from '@agenticbrief/shared-ui/AnswerBox.astro'
import SpecSource from '@agenticbrief/shared-ui/SpecSource.astro'
import PlaneRail from '../components/PlaneRail.astro'
import { aamp } from '@agenticbrief/protocol-data'
import {
  graph,
  organizationNode,
  personNode,
  webSiteNode,
  webPageNode,
  articleNode,
  breadcrumbNode,
  faqPageNode,
  definedTermNode,
  definedTermSetNode,
} from '@agenticbrief/seo/schema'
import { BASE, HUB } from '../lib/site'
import '../styles/aampexplorer.css'

const GH = 'https://github.com/IABTechLab'

const EXPANSIONS = [
  {
    expansion: 'Agentic Advertising Management Protocols',
    where: 'AAMP/README.md:1 and :5',
    url: `${GH}/AAMP/blob/main/README.md`,
    note: "The hub README. IAB Tech Lab's standards page and two buyer-agent guides use it as well.",
  },
  {
    expansion: 'Agentic Advertising Marketplace Protocol',
    where:
      'iab-agentic-primitives/SANDBOX_REGISTRY.md:9, src/iab_agentic_primitives/registry_client.py:3',
    url: `${GH}/iab-agentic-primitives/blob/main/SANDBOX_REGISTRY.md`,
    note: 'Marketplace rather than Management, in shipped source rather than documentation.',
  },
  {
    expansion: 'Agent-to-Agent Marketplace Protocol',
    where:
      'seller-agent/docs/guides/agent-management.md:401, buyer-agent/docs/ai-assistant/slash-commands.md:79',
    url: `${GH}/seller-agent/blob/main/docs/guides/agent-management.md`,
    note: 'Both reference agents, in each case describing the agent registry.',
  },
  {
    expansion: 'IAB Agent & API Management Protocol',
    where: 'seller-agent/docs/architecture/overview.md:143',
    url: `${GH}/seller-agent/blob/main/docs/architecture/overview.md`,
    note: 'One occurrence, in the seller agent architecture overview.',
  },
]

const path = '/what-does-aamp-stand-for/'
const url = `${BASE}${path}`
const title = 'What does AAMP stand for? Agentic Advertising Management Protocols'
const description =
  "AAMP stands for Agentic Advertising Management Protocols. Other files in IAB Tech Lab's own repositories expand the acronym differently, and no implementation changes."
const answer = `AAMP stands for Agentic Advertising Management Protocols, IAB Tech Lab's umbrella name for ${aamp.components.length} repositories covering agent discovery, trust and automated media buying. Other files in those repositories use different expansions of the same acronym.`

const faq = [
  {
    question: 'Who publishes AAMP?',
    answer: `IAB Tech Lab. The repositories are under ${GH}, and the initiative page is at ${aamp.homepage}.`,
  },
  {
    question: 'Do the different expansions mean different things?',
    answer:
      'No. No file in the corpus scopes a schema, field or endpoint to one expansion; the acronym appears only in prose. The four expansions name the same set of repositories.',
  },
]

const breadcrumbs = [
  { name: 'AAMP Explorer', url: `${BASE}/` },
  { name: 'What does AAMP stand for?', url },
]

const related = [
  { href: '/', title: 'What AAMP contains, repository by repository' },
  { href: '/versions/', title: 'Why AAMP has no single version number' },
  { href: '/repos/', title: 'Every AAMP repository, ranked by what it defines' },
  { href: `${HUB}/protocols/adcp-vs-aamp/`, title: 'AdCP compared with AAMP' },
]

const jsonLd = graph([
  organizationNode(),
  personNode(),
  webSiteNode({ siteUrl: BASE, name: 'AAMP Explorer', description }),
  webPageNode({ url, siteUrl: BASE, title, description, breadcrumb: {} }),
  breadcrumbNode(url, breadcrumbs),
  definedTermSetNode({
    url: `${BASE}/`,
    name: 'AAMP Explorer reference',
    description: "IAB Tech Lab's AAMP corpus, documented from source.",
  }),
  definedTermNode({
    url,
    term: 'AAMP',
    definition: answer,
    termSetUrl: `${BASE}/`,
    alternateNames: EXPANSIONS.map((e) => e.expansion),
  }),
  articleNode({
    url,
    title,
    description,
    datePublished: '2026-08-09',
    technical: true,
    keywords: ['what does aamp stand for', 'aamp acronym', 'aamp meaning'],
    citations: [`${GH}/AAMP`, aamp.homepage],
  }),
  faqPageNode(url, faq),
])
---

<PageLayout
  site="aampexplorer"
  title={title}
  heading="What does AAMP stand for?"
  description={description}
  path={path}
  jsonLd={jsonLd}
  ogType="article"
  publishDate={new Date('2026-08-09')}
  keywords={['what does aamp stand for', 'aamp acronym']}
  layout="reference"
  breadcrumbs={breadcrumbs}
  faq={faq}
  related={related}
>
  <PlaneRail slot="nav" />

  <AnswerBox answer={answer} term="AAMP" />

  <p>
    AAMP stands for Agentic Advertising Management Protocols. The hub README at <a
      href={`${GH}/AAMP`}
      rel="noopener nofollow">github.com/IABTechLab/AAMP</a
    > uses that expansion, and so does IAB Tech Lab's <a
      href={aamp.homepage}
      rel="noopener nofollow">standards page</a
    >. Four expansions are written into files in the repositories, one of them Agentic Advertising
    Marketplace Protocol, in shipped source, in <code>iab-agentic-primitives</code>, the one
    repository the hub README does not list. A fifth, Agentic Ad Management Protocol, appears in the
    title of an IAB video episode with the Tech Lab CEO and in no file in the repositories. The
    choice changes nothing an implementer builds — no file in the corpus scopes a schema, field or
    endpoint to one expansion, and the acronym appears only in prose — and it changes what a
    citation resolves to.
  </p>

  <h2>Where each expansion appears</h2>

  <figure class="comparison">
    <table>
      <caption
        >Four expansions of "AAMP" written into files in IAB Tech Lab's own repositories, as they
        stood on 12 August 2026</caption
      >
      <thead
        ><tr
          ><th scope="col">Expansion</th><th scope="col">Where it appears</th><th scope="col"
            >Note</th
          ></tr
        ></thead
      >
      <tbody>
        {
          EXPANSIONS.map((e) => (
            <tr>
              <th scope="row">{e.expansion}</th>
              <td>
                <a href={e.url} rel="noopener nofollow">
                  <code>{e.where}</code>
                </a>
              </td>
              <td>{e.note}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </figure>

  <p>
    Three of the four expansions appear only inside repository files. Neither the hub README nor the
    standards page uses them, so a citation carrying one of those three points at no document that
    defines the term.
  </p>

  <SpecSource provenance={aamp.provenance} />
</PageLayout>
