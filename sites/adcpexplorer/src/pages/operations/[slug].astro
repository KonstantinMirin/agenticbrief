---
/**
 * A dedicated page for the operations people search by name.
 *
 * Deliberately a short list. Everything else is documented under an anchor on
 * its area page, and operationUrl() is the single function that decides which
 * — so no link on the site can point at a page that was not generated.
 */
import PageLayout from '@agenticbrief/shared-ui/PageLayout.astro'
import FieldTable from '@agenticbrief/shared-ui/FieldTable.astro'
import CodeSample from '@agenticbrief/shared-ui/CodeSample.astro'
import SpecSource from '@agenticbrief/shared-ui/SpecSource.astro'
import FaqBlock from '@agenticbrief/shared-ui/FaqBlock.astro'
import DocsTree from '../../components/DocsTree.astro'
import TocRail from '../../components/TocRail.astro'
import '../../styles/site.css'
import { adcp } from '@agenticbrief/protocol-data'
import {
  graph,
  organizationNode,
  personNode,
  webSiteNode,
  webPageNode,
  articleNode,
  breadcrumbNode,
  faqPageNode,
} from '@agenticbrief/seo/schema'
import {
  BASE,
  HUB,
  featuredTasks,
  areaTitle,
  tasksForArea,
  operationUrl,
  LAST_UPDATED,
} from '../../lib/site'

export function getStaticPaths() {
  return featuredTasks().map((task) => ({ params: { slug: task.slug }, props: { task } }))
}

const { task } = Astro.props
const path = `/operations/${task.slug}/`
const url = `${BASE}${path}`
const area = areaTitle(task.area)

const requiredRequest = task.requestFields.filter((f) => f.required)

/**
 * The shared response envelope, derived rather than hand-listed.
 *
 * A response field name that appears in 40+ of the registered schemas is
 * envelope, and the gap either side of that line is wide: the envelope names
 * appear 62-64 times, the next most common response field name appears 32.
 * Defined upstream in core/version-envelope.json and core/protocol-envelope.json.
 */
const responseFieldFrequency = new Map<string, number>()
for (const t of adcp.tasks) {
  for (const f of t.responseFields) {
    responseFieldFrequency.set(f.name, (responseFieldFrequency.get(f.name) ?? 0) + 1)
  }
}
const envelopeNames = new Set(
  [...responseFieldFrequency.entries()].filter(([, n]) => n >= 40).map(([name]) => name),
)
const carriesFullEnvelope = adcp.tasks.filter((t) =>
  [...envelopeNames].every((n) => t.responseFields.some((f) => f.name === n)),
).length
const envelopeOnlyOps = adcp.tasks.filter((t) =>
  t.responseFields.every((f) => envelopeNames.has(f.name)),
).length
const bodyFields = task.responseFields.filter((f) => !envelopeNames.has(f.name))
const requiredResponse = task.responseFields.filter((f) => f.required)

const requiredRequestNames = requiredRequest.map((f) => f.name).join(', ')
const requiredRequestSentence =
  requiredRequest.length === 0
    ? `The request schema declares no required array, so none of the ${task.requestFields.length} request fields carries a top-level required flag.`
    : requiredRequest.length === 1
      ? `One of the ${task.requestFields.length} request fields carries a top-level required flag: ${requiredRequestNames}.`
      : `${requiredRequest.length} of the ${task.requestFields.length} request fields carry a top-level required flag: ${requiredRequestNames}.`

const mutatingOps = adcp.tasks.filter((t) => t.mutatesState).length
const requiresIdempotencyKey = task.requestFields.some(
  (f) => f.name === 'idempotency_key' && f.required,
)
const mutationSentence = task.mutatesState
  ? `${task.name} writes state. Its request schema is one of the ${mutatingOps} in the ${adcp.tasks.length}-entry registry flagged x-mutates-state: true.${
      requiresIdempotencyKey
        ? ' A repeated call is deduplicated only by idempotency_key, which this request requires.'
        : ' Its request schema does not require idempotency_key.'
    }`
  : `${task.name} reads. ${mutatingOps} of the ${adcp.tasks.length} registered operations are flagged x-mutates-state and its request schema is not one of them, so repeating the call is side-effect free.`

const firstBodyFields = bodyFields.slice(0, 3).map((f) => f.name)
const firstBodyFieldList =
  firstBodyFields.length > 1
    ? `${firstBodyFields.slice(0, -1).join(', ')} and ${firstBodyFields[firstBodyFields.length - 1]}`
    : firstBodyFields[0]

const bodyFieldSentence =
  bodyFields.length === 0
    ? `Not one of the ${task.responseFields.length} rows below belongs to ${task.name} itself.`
    : bodyFields.length === 1
      ? `Just one of the ${task.responseFields.length} rows below belongs to ${task.name} itself: ${firstBodyFieldList}.`
      : bodyFields.length <= 3
        ? `Only ${bodyFields.length} of the ${task.responseFields.length} rows below belong to ${task.name} itself: ${firstBodyFieldList}.`
        : `Only ${bodyFields.length} of the ${task.responseFields.length} rows below belong to ${task.name} itself, beginning with ${firstBodyFieldList}.`

const requiredResponseSentence =
  requiredResponse.length === 0
    ? 'No response field is marked required.'
    : requiredResponse.length === 1
      ? `One field in the whole response is marked required: ${requiredResponse[0].name}.`
      : `${requiredResponse.length} fields in the whole response are marked required: ${requiredResponse.map((f) => f.name).join(', ')}.`

/** Label for a code sample, taken from the language the docs tree tagged it with. */
const sampleKind = (language: string) =>
  language === 'json' ? 'wire payload' : `${language} SDK or CLI call`

const title = `${task.name} — AdCP ${adcp.version} ${area} operation reference`
const description = `Field reference for the AdCP ${task.name} operation in release ${adcp.version}: ${task.requestFields.length} request fields, ${task.responseFields.length} response fields, ${requiredRequest.length} of them required, with the shared protocol envelope marked.`

const answer = `${task.name} is an operation in the ${area} area of AdCP ${adcp.version}${
  task.status === 'experimental' ? ', flagged x-status: experimental in its own schema' : ''
}. ${task.summary}`

const faq = [
  {
    question: `What does ${task.name} do?`,
    answer: task.summary,
  },
  {
    question: `Which fields does a ${task.name} request require?`,
    answer:
      requiredRequest.length > 0
        ? `${requiredRequestSentence} AdCP also constrains requests with top-level if/then, anyOf, oneOf and dependencies blocks that no required array captures, so an unmarked field can still be mandatory in the mode being called.`
        : `The published ${adcp.version} schema declares no required array on the ${task.name} request. Constraints can still apply: a top-level if, anyOf, oneOf or dependencies rule fires in one mode only, and a flat field table cannot render it.`,
  },
  {
    question: `Which AdCP version do these ${task.name} field tables describe?`,
    answer: `AdCP ${adcp.version}, the current published release, last updated ${LAST_UPDATED}. The documentation tree is versioned separately from the schema tree in the same repository, so a doc page and a schema file can describe the same field differently.`,
  },
]

const breadcrumbs = [
  { name: 'AdCP Explorer', url: `${BASE}/` },
  { name: area, url: `${BASE}/areas/${task.area}/` },
  { name: task.name, url },
]

const jsonLd = graph([
  organizationNode(),
  personNode(),
  webSiteNode({ siteUrl: BASE, name: 'AdCP Explorer', description }),
  webPageNode({ url, siteUrl: BASE, title, description, breadcrumb: {} }),
  breadcrumbNode(url, breadcrumbs),
  articleNode({
    url,
    title,
    description,
    datePublished: LAST_UPDATED,
    technical: true,
    proficiencyLevel: 'Expert',
    section: area,
    dependencies: 'Model Context Protocol (MCP) or A2A transport',
    keywords: [task.name, `adcp ${task.name}`, `${task.name} adcp`, 'ad context protocol'],
    citations: [task.provenance.sourceUrl, adcp.docsHomepage].filter(Boolean) as string[],
  }),
  faqPageNode(url, faq),
])

const siblings = tasksForArea(task.area).filter((t) => t.name !== task.name)

const hasExamples = task.examples.length > 0
const toc = [
  { id: 'request-fields', label: `${task.name} request fields`, depth: 2 as const },
  { id: 'response-fields', label: `${task.name} response fields`, depth: 2 as const },
  { id: 'shared-envelope', label: 'The shared protocol envelope', depth: 2 as const },
  {
    id: 'field-lists-not-published',
    label: 'Field lists are not published over the wire',
    depth: 2 as const,
  },
  ...(hasExamples
    ? [{ id: 'example-calls', label: `Example ${task.name} calls`, depth: 2 as const }]
    : []),
  { id: 'faq-heading', label: 'Frequently asked', depth: 2 as const },
  { id: 'other-operations', label: `Other operations in ${area}`, depth: 2 as const },
  { id: 'related-heading', label: 'Related', depth: 2 as const },
]
---

<PageLayout
  site="adcpexplorer"
  title={title}
  heading={task.name}
  description={description}
  path={path}
  answer={answer}
  eyebrow={`AdCP ${adcp.version} · ${area}`}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
  layout="reference"
  ogType="article"
  publishDate={new Date(LAST_UPDATED)}
  keywords={[task.name, `adcp ${task.name}`, 'ad context protocol']}
>
  <DocsTree slot="nav" />
  <TocRail slot="aside" toc={toc} />

  <h2 id="request-fields"><code>{task.name}</code> request fields</h2>
  <p>
    The required column reflects the top-level <code>required</code> array only. {
      requiredRequestSentence
    } A top-level <code>if</code>, <code>anyOf</code>, <code>oneOf</code> or <code
      >dependencies</code
    > block can make an unmarked field mandatory in the mode being called, and a flat table cannot render
    a rule that fires in one mode only. Those branches are visible in the request schema itself.
  </p>
  <FieldTable fields={task.requestFields} caption={`${task.name} request`} />

  <p>
    {mutationSentence} AdCP's release notes describe <code>x-mutates-state</code> as a non-normative tooling
    hint that agents do not validate, so it is the registry's classification of the operation rather than
    a contract, and it is the only machine-readable answer in the registry to whether an operation is
    safe to retry.
  </p>

  <h2 id="response-fields"><code>{task.name}</code> response fields</h2>
  {
    bodyFields.length === 0 && (
      <p>
        The response schema for <code>{task.name}</code> declares the envelope and keeps its result
        in a top-level <code>oneOf</code>, <code>anyOf</code> or <code>if</code>, which a table of
        flat rows cannot represent. The branch names are in the response schema. {envelopeOnlyOps}{' '}
        of the {adcp.tasks.length} operations are shaped that way.
      </p>
    )
  }
  <p>
    The first {envelopeNames.size} rows are the shared protocol envelope from <code
      >core/version-envelope.json</code
    > and <code>core/protocol-envelope.json</code>. {bodyFieldSentence}
    {requiredResponseSentence}
  </p>
  <FieldTable fields={task.responseFields} caption={`${task.name} response`} />

  <h2 id="shared-envelope">The shared protocol envelope</h2>
  <p>
    {carriesFullEnvelope} of AdCP's {adcp.tasks.length} registered operations carry every one of the {
      envelopeNames.size
    } envelope fields. <code>report_plan_outcome</code> and <code>check_governance</code> compose <code
      >core/version-envelope.json</code
    > only, so they carry the version pair and none of the task fields.
  </p>
  <p>
    <code>status</code> resolves to <code>enums/task-status.json</code>, which admits nine values:
    submitted, working, input-required, completed, canceled, failed, rejected, auth-required,
    unknown. The envelope marks it required on every response, and a synchronous call emits <code
      >completed</code
    > rather than omitting it. When it returns submitted or working instead, <code>task_id</code> is the
    polling handle and
    <code>push_notification_config</code> is the webhook the agent echoes back to confirm the callback.
    Webhooks are A2A and REST only: MCP sends progress notifications and defines no webhook.
  </p>
  <p>
    <code>payload</code> appears in the response field table typed <code>object</code>. <code
      >core/protocol-envelope.json</code
    > describes it as a documentary construct and states that it is not a required wire field. Body fields
    are siblings of the envelope fields: on MCP at the root of the tool response, on A2A in <code
      >task.artifacts[0].parts[].DataPart</code
    >, on REST at the root of the JSON body. An accessor that reads <code>response.payload</code> finds
    nothing there.
  </p>

  <h2 id="field-lists-not-published">Field lists are not published over the wire</h2>
  <p>
    AdCP's integration guide, <code>docs/protocol/calling-an-agent.mdx</code>, states that its MCP
    servers no longer publish per-tool parameter schemas: a <code>tools/list</code> call returns an empty
    properties object for every tool, and the guide directs clients not to infer shape from it. A client
    author reads the schema registry instead of the tool list.
  </p>

  {
    task.examples.length > 0 && (
      <>
        <h2 id="example-calls">
          Example <code>{task.name}</code> calls
        </h2>
        <p>
          The field tables above come from the {adcp.version} schema release and these blocks come
          from the documentation tree, which is versioned separately, so the two can disagree.
        </p>
        {task.examples.map((ex) => (
          <CodeSample
            title={`${ex.title} — ${sampleKind(ex.language)}`}
            language={ex.language}
            code={ex.code}
            sourceUrl={task.provenance.sourceUrl}
          />
        ))}
      </>
    )
  }

  <FaqBlock entries={faq} />

  <h2 id="other-operations">Other operations in {area}</h2>
  <ul class="task-list">
    {
      siblings.map((t) => (
        <li>
          <a href={operationUrl(t)}>
            <code>{t.name}</code>
          </a>
        </li>
      ))
    }
  </ul>

  <h2 id="related-heading">Related</h2>
  <ul>
    <li><a href={`/areas/${task.area}/`}>The full {area} reference</a></li>
    <li>
      <a href="/">All {adcp.tasks.length} entries in the AdCP {adcp.version} registry</a>
    </li>
    <li>
      <a href={`${HUB}/protocols/adcp-vs-aamp/`} rel="noopener"
        >Does AAMP have an equivalent operation?</a
      >
    </li>
  </ul>

  <SpecSource provenance={task.provenance} specVersion={adcp.version} />
</PageLayout>

<style>
  /*
   * Headword-first density (spec §4.3): the operation name is the h1, set in
   * mono rather than wrapped in an inline <code> — PageLayout's `heading`
   * prop takes a plain string, so the whole h1 (which is just the operation
   * name) takes the mono treatment instead of only a nested element. Scoped
   * to this route only via `:global`, which Astro still bundles into this
   * page's own CSS chunk, not into the other reference page types.
   */
  :global(:root[data-site='adcpexplorer'] .doc-content > article > h1) {
    font-family: var(--font-mono);
    /*
     * ORCHESTRATOR FIX (M4) — was a flat 2.3125rem (37px), which fractured the
     * site's signature device at 390px: `get_adcp_capabil/ities`,
     * `create_media_bu/y`. An operation name broken mid-token is worse than a
     * smaller operation name — the identifier IS the headword.
     *
     * Sized from the data, not guessed. The longest operation name in
     * data/adcp-specs.json is `get_adcp_capabilities` (21 chars). IBM Plex Mono
     * advances ~0.6em, so it needs 21 x 0.6 x size px, against a 390px viewport
     * with 16px padding each side = 358px available:
     *
     *   37px -> 466px  overflows, breaks mid-token
     *   28px -> 353px  fits, but with only 5px to spare
     *   23px -> 290px  fits comfortably
     *
     * clamp floors at 23px (5.9vw at a 390px viewport) and reaches the full
     * 37px at 627px and above, so desktop is unchanged. The body's
     * `overflow-wrap: break-word` stays as a last-resort net for any future
     * name longer than today's corpus.
     */
    font-size: clamp(1.4375rem, 5.9vw, 2.3125rem); /* 23px -> 37px */
    font-weight: 400;
  }
</style>
