---
import { getCollection, render } from 'astro:content'
import DocPage from '@agenticbrief/shared-ui/DocPage.astro'
import { publishedOnly } from '@agenticbrief/content-utils'
import DocsTree from '../../components/DocsTree.astro'
import TocRail from '../../components/TocRail.astro'
import '../../styles/site.css'
import { BASE } from '../../lib/site'

// The rest of this site is generated from the schema registry. The guides
// collection globs `adcp-*` out of content/guides and carries the prose pages
// that do not map onto a single operation or schema group.
export async function getStaticPaths() {
  const entries = publishedOnly(await getCollection('guides'))
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)

// The h2/h3 set is deterministic — it comes from the same markdown Content
// renders, via Astro's own heading extraction, so the TOC can never link to
// an id the page did not emit.
const toc = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ id: h.slug, label: h.text, depth: h.depth as 2 | 3 }))
---

<DocPage
  site="adcpexplorer"
  entry={entry}
  path={`/guides/${entry.id}/`}
  section="Guides"
  layout="reference"
  breadcrumbs={[
    { name: 'AdCP Explorer', url: `${BASE}/` },
    { name: entry.data.title, url: `${BASE}/guides/${entry.id}/` },
  ]}
>
  <DocsTree slot="nav" />
  <TocRail slot="aside" toc={toc} />
  <Content />
</DocPage>
