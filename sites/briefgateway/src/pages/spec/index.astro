---
import { getEntry, render } from 'astro:content'
import DocPage from '@agenticbrief/shared-ui/DocPage.astro'
import { siteUrl } from '@agenticbrief/shared-ui/sites'
import '../../styles/briefgateway.css'

const entry = await getEntry('briefs', 'spec')
if (!entry) throw new Error('content/briefs/spec.md is missing')
const { Content } = await render(entry)
const BASE = siteUrl('briefgateway')
---

<DocPage
  site="briefgateway"
  entry={entry}
  path="/spec/"
  breadcrumbs={[
    { name: 'Brief Gateway', url: `${BASE}/` },
    { name: 'The spec', url: `${BASE}/spec/` },
  ]}
>
  <Content />
</DocPage>
