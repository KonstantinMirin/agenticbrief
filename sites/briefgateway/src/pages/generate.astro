---
/**
 * The brief scorer.
 *
 * Paste prose, get the AdCP `get_products` request and the AAMP CampaignBrief
 * that fall out of it, with every field labelled stated / derived / assumed /
 * missing. The engine is `@agenticbrief/brief-engine`: deterministic, rule
 * based, no network, no model. It runs at build time to produce the example
 * below and in the browser for everything the reader types afterwards.
 *
 * Two structural decisions worth knowing before reading this file:
 *
 * 1. THE RENDERER IS MIRRORED. The block marked MIRRORED RENDERER appears
 *    twice — once in this frontmatter, once in the client <script> — and the
 *    two copies are the same code, differing only in the indentation Prettier
 *    gives them (never inside a template literal, so the emitted HTML is
 *    identical). Astro compiles frontmatter and client script as separate
 *    modules with no shared scope, and this page may not add a file to import
 *    from. Copying one implementation verbatim keeps the two from drifting and
 *    makes the HTML a crawler sees for the example identical to the HTML a
 *    browser builds for the same input.
 *
 * 2. NO-JS IS NOT A DEGRADED PAGE. The explanation, the example brief in the
 *    textarea, the scores, the whole field table, the blockers and both
 *    payloads are server-rendered at build time. Without JavaScript the reader
 *    loses the ability to score their own text and to accept an assumption —
 *    and nothing else. Assumptions are off in that state, as they are on first
 *    render with JavaScript on.
 */
import PageLayout from '@agenticbrief/shared-ui/PageLayout.astro'
import { siteUrl } from '@agenticbrief/shared-ui/sites'
import {
  breadcrumbNode,
  faqPageNode,
  graph,
  softwareApplicationNode,
  webPageNode,
} from '@agenticbrief/seo/schema'
import { analyze, FIELDS } from '@agenticbrief/brief-engine'
import type { EngineAnalysis, FieldValue, Span } from '@agenticbrief/brief-engine'
import { EXAMPLE_BRIEF } from '../lib/example-brief'
import '../styles/briefgateway.css'

const BASE = siteUrl('briefgateway')
const PATH = '/generate/'

/*
 * The canonical example — the same brief the engine's extractor suites are
 * written against, so what this page shows is what the tests assert. It moved
 * to `../lib/example-brief` when the homepage started printing the same
 * paragraph and the same classification; see that file for why. The string
 * itself is unchanged, and only this frontmatter reads it — the mirrored
 * client renderer below takes its input from the textarea, so nothing about
 * the two-copy arrangement changes.
 */

/**
 * The reference date for relative-date derivation ("next quarter"), read once,
 * here, at build time. It is passed explicitly rather than left to default so
 * that the one clock read on this page is visible in the source and reported
 * on the page itself. In the browser the reference date is the reader's today.
 */
const analysis = analyze(EXAMPLE_BRIEF, { now: new Date() })

/* ==================================================================== *
 * MIRRORED RENDERER — the same code as the copy in the <script> below.
 * Change one, change both. Nothing inside a template literal is indented, so
 * the two copies emit identical HTML.
 * ==================================================================== */

interface Ui {
  accepted: readonly string[]
  hideMissing: boolean
}

const GROUPS: ReadonlyArray<readonly [string, string]> = [
  ['identity', 'Identity'],
  ['timing', 'Timing'],
  ['budget', 'Budget'],
  ['geo', 'Geography'],
  ['inventory', 'Inventory'],
  ['creative', 'Creative'],
  ['audience', 'Audience'],
  ['measurement', 'Measurement'],
  ['safety', 'Brand safety'],
  ['governance', 'Governance'],
]

const ESCAPES: Record<string, string> = {
  '&': '&amp;',
  '<': '&lt;',
  '>': '&gt;',
  '"': '&quot;',
  "'": '&#39;',
}

/** Everything interpolated into HTML goes through this, engine text included. */
function esc(value: unknown): string {
  return String(value ?? '').replace(/[&<>"']/g, (c) => ESCAPES[c] as string)
}

function cut(text: string, limit: number): string {
  return text.length > limit ? `${text.slice(0, limit - 1)}…` : text
}

/** A field value as one line. Objects stay JSON so nothing is paraphrased. */
function fmtValue(value: unknown): string {
  if (value === undefined || value === null) return ''
  if (typeof value === 'string') return value
  if (typeof value === 'number' || typeof value === 'boolean') return String(value)
  return JSON.stringify(value)
}

function chip(label: string): string {
  return `<span class="chip chip-${esc(label)}">${esc(label)}</span>`
}

function fieldLabel(key: string): string {
  return FIELDS.find((f) => f.key === key)?.label ?? key
}

function fieldOrder(key: string): number {
  const i = FIELDS.findIndex((f) => f.key === key)
  return i === -1 ? FIELDS.length : i
}

/** The source span, quoted with enough either side to recognise it. */
function evidence(input: string, spans: readonly Span[]): string {
  return spans
    .slice(0, 3)
    .map((s) => {
      const before = input.slice(Math.max(0, s.start - 24), s.start)
      const after = input.slice(s.end, Math.min(input.length, s.end + 24))
      const head = s.start > 0 ? '…' : ''
      const tail = s.end < input.length ? '…' : ''
      return `<span class="quote">${head}${esc(before)}<mark>${esc(cut(s.text, 90))}</mark>${esc(after)}${tail}</span>`
    })
    .join('')
}

function metaLine(a: EngineAnalysis): string {
  const ref = a.meta.options.now
  const when = ref
    ? `relative dates resolved against ${esc(new Date(ref).toISOString().slice(0, 10))}`
    : 'no reference date supplied, so relative dates were left unresolved'
  return (
    `AdCP schema ${esc(a.meta.adcpVersion)} · ` +
    `buying mode <code>${esc(a.meta.options.buyingMode)}</code> · ` +
    when
  )
}

/** The sentence the live region announces. */
function statusLine(a: EngineAnalysis): string {
  const t = a.scores.transactable
  const e = a.scores.expressive
  const blocking = a.blockers.filter((b) => b.severity === 'blocks').length
  return (
    `Scored. Transactable ${t.score} of ${t.of}. Expressive ${e.score} of ${e.of}. ` +
    `${a.blockers.length} things a seller will guess or drop, ${blocking} of them blocking.`
  )
}

function renderScores(a: EngineAnalysis): string {
  const t = a.scores.transactable
  const e = a.scores.expressive
  const failed = t.checks.filter((c) => !c.passed)
  const unused = e.of - e.score
  return `<section class="panel" aria-labelledby="h-score">
<h2 id="h-score">The score</h2>
<div class="scores">
<div class="score" data-pass="${t.ok}">
<p class="score-name">Transactable <span class="score-kind">gate</span></p>
<p class="score-value"><strong>${t.score}</strong> of ${t.of}</p>
<p class="score-what">AAMP <code>CampaignBrief</code>&#39;s eight required fields, plus a <code>budget_pct</code> on every channel allocation, plus one check that the AdCP <code>get_products</code> request validates. Counted against the emitted payloads, not your sentences.</p>
${
  failed.length === 0
    ? `<p class="score-pass">All ${t.of} checks pass.</p>`
    : `<p class="score-fail">${failed.length} fail:</p><ul class="checks">${failed
        .map((c) => `<li><strong>${esc(c.label)}</strong> — ${esc(c.reason)}</li>`)
        .join('')}</ul>`
}
</div>
<div class="score">
<p class="score-name">Expressive <span class="score-kind">coverage, not a target</span></p>
<p class="score-value"><strong>${e.score}</strong> of ${e.of}</p>
<p class="score-what">AdCP <code>filters.*</code> fields your brief populates. The other ${unused} go to the seller empty, so nothing in them is filtered on. Every populated filter is a hard constraint that deletes products: <a href="/spec/brief-vs-filters/">brief vs filters</a> has the routing rule.</p>
${
  e.score === 0
    ? '<p class="score-fail">No filter is populated. The seller gets the brief string and nothing to filter on.</p>'
    : `<p class="score-used">Populated: ${e.used.map((u) => `<code>${esc(u)}</code>`).join(' ')}</p>`
}
</div>
</div>
<p class="provenance">${metaLine(a)}</p>
<p class="provenance">Relative dates use today's date. Write absolute dates for a result that holds next week.</p>
</section>`
}

function fieldRow(a: EngineAnalysis, key: string): string {
  const def = FIELDS.find((f) => f.key === key)
  if (!def) return ''
  const fv: FieldValue<unknown> = a.fields[key] ?? { label: 'missing', spans: [] }
  const spans = fv.spans ?? []
  const value =
    fv.label === 'missing'
      ? '<span class="cell-empty">no value</span>'
      : `<code>${esc(cut(fmtValue(fv.value), 140))}</code>`
  let why = ''
  if (fv.label === 'stated') {
    why = evidence(a.input, spans)
  } else if (fv.label === 'derived' || fv.label === 'assumed') {
    why = `<span class="rule">${esc(fv.rule ?? '')}</span>${
      spans.length > 0 ? evidence(a.input, spans) : ''
    }`
  } else {
    why = `<span class="muted">${esc(def.consequence)}</span>`
  }
  if (fv.note) why += `<span class="note">${esc(fv.note)}</span>`
  return `<tr data-label="${esc(fv.label)}">
<td><code>${esc(def.key)}</code></td>
<td>${esc(def.label)}</td>
<td>${value}</td>
<td>${chip(fv.label)}</td>
<td>${why}</td>
</tr>`
}

function renderFields(a: EngineAnalysis, ui: Ui): string {
  const counts = a.scores.labels
  const body = GROUPS.map(([group, name]) => {
    const keys = FIELDS.filter((f) => f.group === group).map((f) => f.key)
    return `<tbody><tr class="group-row"><th colspan="5" scope="colgroup">${esc(name)}</th></tr>${keys
      .map((k) => fieldRow(a, k))
      .join('')}</tbody>`
  }).join('')
  return `<section class="panel fields" aria-labelledby="h-fields">
<h2 id="h-fields">Every field, and where it came from</h2>
<p>${counts.stated} stated, ${counts.derived} derived, ${counts.assumed} assumed, ${counts.missing} missing, of ${a.scores.fieldsTotal} the two protocols can express between them.</p>
<input type="checkbox" id="hide-missing" class="toggle"${ui.hideMissing ? ' checked' : ''} />
<label for="hide-missing" class="toggle-label">Hide the fields with no value</label>
<figure class="comparison">
<table class="field-table">
<caption>One row per concept, including the ones this brief says nothing about.</caption>
<thead><tr><th scope="col">Field</th><th scope="col">What it is</th><th scope="col">Value</th><th scope="col">Label</th><th scope="col">Evidence</th></tr></thead>
${body}
</table>
</figure>
</section>`
}

function renderAssumptions(a: EngineAnalysis, ui: Ui): string {
  const keys = [...new Set([...Object.keys(a.offered), ...ui.accepted])].sort(
    (x, y) => fieldOrder(x) - fieldOrder(y),
  )
  const applied = keys.filter((k) => ui.accepted.includes(k)).length
  const items = keys
    .map((key) => {
      const fv = a.offered[key] ?? a.fields[key]
      if (!fv) return ''
      const on = ui.accepted.includes(key)
      return `<div class="assumption${on ? ' is-on' : ''}">
<input type="checkbox" class="accept" id="assume-${esc(key)}" data-assume="${esc(key)}"${on ? ' checked' : ''} />
<label for="assume-${esc(key)}"><strong>${esc(fieldLabel(key))}</strong> = <code>${esc(cut(fmtValue(fv.value), 140))}</code></label>
<p class="rule">${esc(fv.rule ?? '')}</p>
<p class="assumption-state">${
        on
          ? 'Accepted. It is in both payloads below, labelled assumed everywhere it appears.'
          : 'Not accepted, so it is in nothing below.'
      }</p>
</div>`
    })
    .join('')
  return `<section class="panel assumptions" aria-labelledby="h-assume">
<h2 id="h-assume">Assumptions — ${applied === 0 ? 'none applied' : `${applied} applied`}</h2>
<p>Values the engine could pick and has not. Accept one and both payloads are emitted again with it in, labelled <code>assumed</code>. Accept nothing and nothing here reaches a seller. Scoring a brief again clears every acceptance.</p>
${
  keys.length === 0
    ? '<p class="muted">Nothing to offer for this brief. Every value below came from your words.</p>'
    : items
}
<noscript><p class="muted">JavaScript is off, so these boxes do nothing and no assumption is applied.</p></noscript>
</section>`
}

function renderBlockers(a: EngineAnalysis): string {
  const item = (b: EngineAnalysis['blockers'][number]): string =>
    `<li><span class="chip chip-sev-${esc(b.severity)}">${esc(b.severity)}</span> <strong>${esc(
      b.field ? fieldLabel(b.field) : 'The request',
    )}</strong> — ${esc(b.detail)} <span class="muted">${esc(b.consequence)}</span></li>`
  const of = (severity: string) => a.blockers.filter((b) => b.severity === severity)
  const blocks = of('blocks')
  const drops = of('drops')
  const degrades = of('degrades')
  return `<section class="panel" aria-labelledby="h-blockers">
<h2 id="h-blockers">What a seller will guess or drop</h2>
<p>${a.blockers.length} in all: ${blocks.length} stop the brief constructing, ${drops.length} are read here and travel in neither payload, ${degrades.length} leave a field empty for the seller to fill however it likes.</p>
${
  blocks.length > 0
    ? `<h3>Blocks — nothing ships</h3><ul class="blockers">${blocks.map(item).join('')}</ul>`
    : ''
}
${
  drops.length > 0
    ? `<h3>Drops — read here, carried in neither payload</h3><ul class="blockers">${drops
        .map(item)
        .join('')}</ul>`
    : ''
}
${
  degrades.length > 0
    ? `<details><summary>Degrades — ${degrades.length} fields the seller fills for you</summary><ul class="blockers">${degrades
        .map(item)
        .join('')}</ul></details>`
    : ''
}
</section>`
}

function renderPane(opts: {
  id: string
  heading: string
  note: string
  payload: unknown
  omitted: EngineAnalysis['omitted']['adcp']
}): string {
  const json = JSON.stringify(opts.payload, null, 2)
  return `<section class="pane" aria-labelledby="h-${esc(opts.id)}">
<div class="pane-head">
<h3 id="h-${esc(opts.id)}">${opts.heading}</h3>
<button type="button" class="copy" data-copy="${esc(opts.id)}-json">Copy ${esc(opts.id.toUpperCase())} JSON</button>
</div>
<p class="pane-note">${opts.note}</p>
<pre id="${esc(opts.id)}-json"><code>${esc(json)}</code></pre>
<details>
<summary>${opts.omitted.length} fields left out of this payload, and what that costs</summary>
<ul class="omitted">${opts.omitted
    .map(
      (o) =>
        `<li><code>${esc(o.field)}</code> ${chip(o.label)} <span class="muted">${esc(o.reason)}</span></li>`,
    )
    .join('')}</ul>
</details>
</section>`
}

function renderOutputs(a: EngineAnalysis): string {
  return `<section class="panel" aria-labelledby="h-out">
<h2 id="h-out">What gets sent</h2>
<div class="panes">
${renderPane({
  id: 'adcp',
  heading: 'AdCP <code>get_products</code> request',
  note: 'Structured filters plus the residual prose, which AdCP carries as one unvalidated string.',
  payload: a.adcp,
  omitted: a.omitted.adcp,
})}
${renderPane({
  id: 'aamp',
  heading: 'AAMP <code>CampaignBrief</code>',
  note: 'IAB Tech Lab buyer agent, models/campaign_brief.py — eight required fields, cross-field validators.',
  payload: a.aamp,
  omitted: a.omitted.aamp,
})}
</div>
</section>`
}

function renderResults(a: EngineAnalysis, ui: Ui): string {
  return (
    renderScores(a) +
    renderFields(a, ui) +
    renderAssumptions(a, ui) +
    renderBlockers(a) +
    renderOutputs(a)
  )
}

/* ==================================================================== *
 * END MIRRORED RENDERER
 * ==================================================================== */

const initialUi: Ui = { accepted: [], hideMissing: false }
const initialResults = renderResults(analysis, initialUi)
const initialStatus = statusLine(analysis)

const TITLE = 'Score a campaign brief'
const DESCRIPTION =
  'Paste a campaign brief and see the AdCP get_products request and AAMP CampaignBrief it produces, ' +
  'with every field labelled stated, derived, assumed or missing. Free, no account, runs in your browser.'

const FAQ = [
  {
    question: 'Why does it refuse to fill in the channel split?',
    answer:
      'Because a split is a commitment and nothing in your text implies one. Values the engine could pick are listed under Assumptions with the rule that produced them, and they reach neither payload until you accept them.',
  },
  {
    question: 'Will a higher score get me better inventory?',
    answer:
      'Unproven. The score counts which values reach a protocol field. Three sales agents in the public AdCP registry answer an anonymous get_products, and one of them returns the same four products whatever the brief says.',
  },
  {
    question: 'Which AAMP CampaignBrief does it emit?',
    answer:
      'The one in models/campaign_brief.py, with eight required fields and cross-field validators. The IAB Tech Lab buyer-agent repository defines a second, incompatible CampaignBrief in models/flow_state.py and ships no adapter between them.',
  },
]

const BREADCRUMBS = [
  { name: 'Brief Gateway', url: `${BASE}/` },
  { name: 'Score a brief', url: `${BASE}${PATH}` },
]

const jsonLd = graph([
  webPageNode({
    url: `${BASE}${PATH}`,
    siteUrl: BASE,
    title: TITLE,
    description: DESCRIPTION,
    breadcrumb: breadcrumbNode(`${BASE}${PATH}`, BREADCRUMBS),
  }),
  breadcrumbNode(`${BASE}${PATH}`, BREADCRUMBS),
  softwareApplicationNode({
    url: `${BASE}${PATH}`,
    name: 'Brief Gateway brief scorer',
    description: DESCRIPTION,
  }),
  faqPageNode(`${BASE}${PATH}`, FAQ),
])
---

<PageLayout
  site="briefgateway"
  title={TITLE}
  description={DESCRIPTION}
  path={PATH}
  wide
  eyebrow="Tool"
  answer={`Paste a campaign brief and get the AdCP get_products request and the AAMP CampaignBrief it produces, every value labelled stated, derived, assumed or missing, against ${analysis.scores.expressive.of} typed AdCP filter fields and the AAMP required set.`}
  breadcrumbs={BREADCRUMBS}
  faq={FAQ}
  jsonLd={jsonLd}
  related={[
    {
      href: '/guides/brief-preflight-checklist/',
      title: 'The brief pre-flight checklist',
      note: 'The questions to settle with your team before an agent reads any of this.',
    },
    {
      href: '/guides/brief-completeness-rubric/',
      title: 'The brief completeness rubric',
      note: 'The published field map this tool scores against, and the two protocols behind it.',
    },
    {
      href: '/spec/brief-vs-filters/',
      title: 'Brief vs filters',
      note: 'Which parts of a brief belong in prose and which belong in a validated field.',
    },
  ]}
>
  <p class="lead-note muted">
    Rule-based and deterministic: same words in, same payloads out. Nothing is sent anywhere, no
    account, no email. Paste the brief, read the two scores, then work down the list of what a
    seller will guess or drop.
  </p>

  <div class="bench">
    <section class="panel tool" aria-labelledby="h-input">
      <h2 id="h-input">Paste the brief</h2>
      <label class="input-label" for="brief-input">
        Your campaign brief, in whatever prose you already write it in
      </label>
      <div class="field">
        <textarea
          id="brief-input"
          name="brief"
          rows="8"
          spellcheck="false"
          aria-describedby="input-help">{EXAMPLE_BRIEF}</textarea
        >
      </div>
      <p id="input-help" class="muted">
        Pre-filled with a worked example. The results below are its output. Replace it with yours
        and score it. Scoring again clears any accepted assumptions.
      </p>
      <div class="actions">
        <button type="button" id="score" class="primary">Score this brief</button>
        <button type="button" id="restore" class="secondary">Restore the example</button>
      </div>
      <noscript>
        <p class="muted">
          JavaScript is off, so neither button does anything. Everything below is the real output
          for the brief in the box, produced by the same engine when this page was built.
        </p>
      </noscript>
    </section>

    <section class="panel" aria-labelledby="h-labels">
      <h2 id="h-labels">The four labels</h2>
      <dl class="labels">
        <dt><span class="chip chip-stated">stated</span></dt>
        <dd>You said it. The exact words are quoted back with the value.</dd>
        <dt><span class="chip chip-derived">derived</span></dt>
        <dd>
          Unambiguously implied, and the rule that fired is printed next to it. <q>United States</q> to
          <code>countries: ["US"]</code> is a derivation. A channel split is not.
        </dd>
        <dt><span class="chip chip-assumed">assumed</span></dt>
        <dd>
          The engine picked it. Off by default and listed on its own; it reaches neither payload
          until you tick its box.
        </dd>
        <dt><span class="chip chip-missing">missing</span></dt>
        <dd>Not present and not derivable. The seller will guess it or drop it.</dd>
      </dl>
      <p class="muted">
        A value can be read correctly, labelled <code>stated</code>, and still reach neither
        payload, because neither protocol has a field to carry it.
      </p>
    </section>
  </div>

  <p id="score-status" class="results-status" role="status" aria-live="polite">{initialStatus}</p>

  <div id="results" tabindex="-1" set:html={initialResults} />

  <section class="panel" aria-labelledby="h-limits">
    <h2 id="h-limits">What it will not do</h2>
    <ul>
      <li>
        The transactable score covers the request-level rules this engine is capable of breaking.
        Full JSON Schema validation against the AdCP release does not run in your browser, so a
        payload that clears it here can still fail a seller's validator.
      </li>
    </ul>
  </section>

  <section class="panel" aria-labelledby="h-next">
    <h2 id="h-next">Before you send it</h2>
    <ol>
      <li>
        Clear the blocks first. Those are values a required field wants and does not have, so
        nothing downstream runs.
      </li>
      <li>
        Read the drops. You wrote those, and neither protocol has anywhere to put them — say them to
        your counterparty in a channel that is not this one.
      </li>
      <li>
        Settle the assumptions with the people who have to agree. <a
          href="/guides/brief-preflight-checklist/">The pre-flight checklist</a
        > is the list of questions to put to them.
      </li>
    </ol>
    <p>
      The field map behind the two scores is published as <a
        href="/guides/brief-completeness-rubric/">the completeness rubric</a
      >, concept by concept.
    </p>
  </section>
</PageLayout>

<!--
  Global rather than scoped: the client renderer writes its HTML with innerHTML,
  and Astro's scoping attribute is only applied to elements present in this
  template. Every selector below is namespaced under an id or a class this page
  owns, so nothing leaks into the shared stylesheet's territory.
-->
<style is:global>
  /* ==================================================================
   * /generate/ is a CONFIGURE surface (design-research §4.2): no hero,
   * form first, density over decoration. What this pass changed is the
   * COMPOSITION, not the controls — the page's three grey rounded panels
   * (the legend, the two score cards) were card hierarchy on a site whose
   * separation mechanic is hairline-exclusive. They are now rules and
   * space, and the ONE tinted region left is the machine's own readout.
   * The editorial devices are the same two the rest of the site uses:
   * the sheet rule at every section open (editorial-references §2.1/§2.3)
   * and the Mono/Sans machine-vs-human split (§2.7).
   * ================================================================== */

  .lead-note {
    font-size: 1rem; /* 16px */
    margin-bottom: 0;
  }

  /* No bottom margin: §2.9's rhythm is carried by the BREAK (the rule and
     its 64px of space above), not by a padding box on every region. */
  .panel {
    margin: 0;
  }

  /* THE SECTION OPEN. Identical device to `main.wide article > h2` in
     briefgateway.css: the rule is an absolutely-positioned pseudo stretched
     across `article` (the positioning context set in that file), so it runs
     the full 1180px sheet while the heading text stays in the column.
     Applies to every `.panel` the client renderer injects into #results as
     well, because it is a class rule and not a source-order rule. */
  .panel > h2 {
    position: static;
    max-width: 38rem; /* ≈32ch at the 32px Heading 02 size */
    margin: var(--break-space-above) 0 var(--break-space-below);
    padding-top: var(--break-space-lead);
  }

  .panel > h2::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    margin-top: calc(-1 * var(--break-space-lead));
    background: var(--rule-sheet); /* #c6c6c6 — decorative divider, 1.71:1 on #ffffff */
  }

  /* PROSE RUNS THE COLUMN, EVIDENCE RUNS THE SHEET — the same law
     briefgateway.css applies to every doc page, applied here to the
     regions the client renderer injects. Without it the explanatory
     paragraph under each result heading ran the full 1180px sheet at
     roughly 100ch, which is the widest prose anywhere in the portfolio and
     sat directly under a 66ch-capped page. `.scores`, `.panes` and
     `figure.comparison` are deliberately absent: those are evidence and
     they keep the sheet. */
  .panel > p,
  .panel > ul,
  .panel > ol,
  .panel > details,
  .assumptions > .assumption {
    max-width: var(--measure);
  }

  /* ---------- bench: the Configure two-column composition (spec §6.1) ----------
     <1056px: single column, 48px gap, legend after the form (grid's default
     implicit single track). >=1056px: control column (--form-column, 640px)
     beside the reference legend (240-360px). */
  .bench {
    display: grid;
    gap: 48px;
    margin-top: var(--break-space-above);
  }

  @media (min-width: 1056px) {
    .bench {
      grid-template-columns: minmax(0, var(--form-column)) minmax(240px, 360px);
      gap: 0 32px;
      align-items: start;
    }
  }

  /* Both bench panels open on the SAME column rule at the same y, so the
     control column and the reference legend read as one bench rather than
     as a form beside a card. Column rule, not sheet rule: these two sit
     inside the grid, and the sheet rule means "a section of the document"
     (briefgateway.css §2). */
  .bench > .panel {
    margin: 0;
    border-top: 1px solid var(--rule-column); /* #e0e0e0 — decorative divider */
    padding-top: var(--break-space-lead);
  }

  .bench > .panel > h2 {
    margin-top: 0;
    padding-top: 0;
  }

  .bench > .panel > h2::before {
    content: none;
  }

  /* ---------- mobile re-layout — Tell 10 (adversarial review, mobile
     source order) ----------
     At <=671px the primary control (the textarea) sank below the eyebrow,
     h1, AnswerBox and a 5-line lead-note — roughly 930-965px down, below
     the fold on every common phone, on the portfolio's single most
     valuable Configure surface. `order` is visual only: it does not touch
     DOM order, so the AnswerBox keeps its source-order precedence for
     answer extraction and no copy moves, is added, or is reworded — the
     only repair shape a styling-only pass permits. Everything not given an
     explicit order here keeps its natural relative position (flex sorts
     ties by document order), so AnswerBox -> lead-note -> score-status ->
     results -> the closing panels -> FAQ/related/engagement are unchanged
     relative to each other; only the eyebrow/h1 pair and `.bench` move
     ahead of them. */
  @media (max-width: 671px) {
    article:has(.bench) {
      display: flex;
      flex-direction: column;
    }

    article:has(.bench) > .eyebrow,
    article:has(.bench) > h1 {
      order: -2;
    }

    article:has(.bench) > .bench {
      order: -1;
    }
  }

  /* The reference legend. WAS an #f4f4f4 rounded box — i.e. a card, and the
     one on this page that carried no machine output at all, so it broke the
     ground law (a tint means "the program produced this"). It is now
     apparatus: a rule, a kicker and space. Its heading drops from Heading 04
     to the label primitive, which is what tells a reader at a glance that
     the right-hand column is a legend and the left-hand one is the tool —
     the hierarchy the card was faking (§2.1). */
  .bench > .panel:not(.tool) > h2 {
    font-family: var(--machine-face);
    font-size: var(--label-size); /* 13px */
    font-weight: var(--label-weight); /* 400 — Plex Mono has no other weight */
    line-height: var(--label-lh);
    letter-spacing: var(--track-label); /* +1px */
    text-transform: var(--label-transform);
    /* [computed] #525252 on #ffffff = 7.81:1 */
    color: var(--fg-muted);
    margin-bottom: var(--break-space-below);
  }

  /* ---------- input ---------- */

  .tool .input-label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.16px;
    margin-bottom: 8px;
  }

  /* Linear reset + Stripe Elements state layer (spec §6.2, §6.4). The field
     wrapper carries the ring/border; the textarea itself is bare. */
  .tool .field {
    background: var(--field-bg);
    border: 1px solid var(--field-border);
    border-radius: var(--site-radius);
    box-shadow: var(--field-shadow-resting);
    padding: 12px 16px;
    transition: box-shadow var(--motion-fast) var(--motion-ease);
  }

  .tool .field:hover {
    border-color: var(--cds-text-secondary);
  }

  .tool .field:focus-within {
    box-shadow: var(--field-shadow-focus);
  }

  /* Specified and ready; nothing sets `data-invalid` yet — wiring it needs
     three lines in the frozen <script> region, out of scope for this design
     pass (spec §6.3, §10 item 3). */
  .tool .field[data-invalid] {
    box-shadow: var(--field-shadow-invalid);
    border-color: var(--status-error);
  }

  .tool textarea {
    appearance: none;
    background: transparent;
    border: none;
    outline: none;
    width: 100%;
    padding: 0;
    resize: vertical;
    font-family: var(--font-mono);
    /* 16px — ruling 1, non-negotiable. WAS 0.9rem (14.4px), below the iOS
       Safari auto-zoom threshold, on the one field a user types into. */
    font-size: 16px;
    line-height: 1.6;
    color: var(--fg);
  }

  .tool textarea::placeholder {
    color: var(--cds-text-placeholder);
  }

  /* MUST-FIX (adversarial review #2): briefgateway.css's sitewide
     `:focus-visible { box-shadow: var(--focus-ring) }` is unscoped, and
     nothing zeroes the bare textarea's own box-shadow, so tabbing into it
     painted two concentric rings — the wrapping `.field`'s state ring
     (`:focus-within`, above) and this rule's own, in two different greys.
     The wrapper already carries the ring; the textarea itself takes none. */
  .tool textarea:focus-visible {
    box-shadow: none;
  }

  #input-help {
    font-size: 14px;
    margin-top: 8px;
  }

  .tool .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 16px 0 0;
  }

  /* ---------- buttons — three variants, no more (spec §6.8) ---------- */

  button.primary,
  button.secondary,
  button.copy {
    font-family: inherit;
    font-weight: 600; /* was 700 on .primary — the chassis ships 300/400/600 only */
    border-radius: var(--site-radius);
    cursor: pointer;
    transition:
      background var(--motion-fast) var(--motion-ease),
      box-shadow var(--motion-fast) var(--motion-ease),
      transform var(--motion-fast) var(--motion-ease);
  }

  button.primary,
  button.secondary {
    min-height: 48px;
    padding: 0 16px;
    font-size: 16px;
  }

  button.copy {
    min-height: 44px;
    padding: 0 12px;
    font-size: 14px;
    letter-spacing: 0.16px;
  }

  button.primary {
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
    border: 1px solid var(--btn-primary-bg);
  }

  button.primary:hover {
    background: var(--btn-primary-bg-hover); /* #ffffff on #393939 = 11.55:1 */
  }

  button.secondary,
  button.copy {
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--field-border);
  }

  button.secondary:hover,
  button.copy:hover {
    background: var(--bg-subtle);
  }

  button.copy[data-state='done'] {
    color: var(--status-success);
    border-color: currentColor;
  }

  button:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    button.primary,
    button.secondary,
    button.copy {
      transition: none;
    }

    button:active {
      transform: none;
    }
  }

  /* ---------- labels legend ---------- */

  dl.labels {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 12px 16px;
    align-items: baseline;
    font-size: 16px;
  }

  dl.labels dd {
    margin: 0;
  }

  /* ---------- chips — the verdict vocabulary (spec §6.6) ----------
     A chip is the program's verdict on the reader's own words, so it is in
     the machine face (§2.7) — but LOWERCASE, where every sibling's chip is
     uppercase mono (adcp version tags, aamp licence chips). Lowercase is
     how the published copy writes the four labels, and it keeps the chip
     row from shouting over the values it is labelling. */

  .chip {
    display: inline-block;
    font-family: var(--machine-face);
    font-size: 12px;
    font-weight: var(--machine-weight); /* 400 — Plex Mono has no other weight */
    letter-spacing: 0.32px; /* Caption 01 tracking law */
    text-transform: none;
    padding: 2px 6px;
    border-radius: var(--radius-2); /* 2px, not whatisagenticbuying's 3px */
    border: 1px solid currentColor;
    white-space: nowrap;
  }

  .chip-stated {
    color: var(--status-success);
  }

  .chip-derived {
    color: var(--status-info); /* was #2f6feb — the last stock blue in the portfolio */
  }

  .chip-assumed {
    color: var(--status-warning);
  }

  .chip-missing {
    color: var(--status-neutral);
  }

  .chip-sev-blocks {
    color: var(--status-error);
  }

  .chip-sev-drops {
    color: var(--status-warning);
  }

  .chip-sev-degrades {
    color: var(--status-neutral);
  }

  /* ---------- scores — Monitor secondary (spec §6.5) ---------- */

  /* ONE instrument, not two cards. The two scores used to be two separate
     rounded #f4f4f4 boxes side by side — the shape design-research §4.3
     tell 3 describes, and the only place on this page that read as a
     feature grid. They are now a single readout panel divided by one 1px
     seam: the same information, one object. This is also why `align-items`
     goes back to stretch — the old `start` existed to stop an empty card
     looking empty, and there is no second card any more; the unused height
     is now part of the instrument. The tint is legitimate here and only
     here in this region: it IS machine output (THE GROUND LAW). */
  .scores {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1px;
    background: var(--rule-sheet); /* the seam — #c6c6c6, 1.55:1 on the #f4f4f4 panel */
    border-radius: var(--site-radius);
    overflow: hidden;
    align-items: stretch;
  }

  .score {
    background: var(--bg-subtle); /* #f4f4f4 — machine ground */
    border: none;
    box-shadow: none; /* rings are STATE; this is structure */
    border-radius: 0;
    padding: 20px;
  }

  .score-name {
    margin: 0;
    font-family: var(--machine-face);
    font-size: 13px;
    font-weight: var(--machine-weight); /* 400 */
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    /* [computed] #525252 on #f4f4f4 = 7.10:1 */
    color: var(--fg-muted);
  }

  .score-kind {
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  .score-value {
    margin: 4px 0 12px;
    font-family: var(--machine-face);
    font-variant-numeric: tabular-nums;
    font-size: 1.125rem;
    /* [computed] #525252 on #f4f4f4 = 7.10:1 */
    color: var(--fg-muted);
  }

  /* 40px, deliberately below the h1's 48px, so the score never becomes the
     loudest thing on the page (slop tell 6). */
  .score-value strong {
    font-size: 2.5rem;
    font-weight: 400;
    line-height: 1.19;
    color: var(--fg);
  }

  .score[data-pass='true'] .score-value strong {
    color: var(--status-success);
  }

  .score-what,
  .score-used,
  .score-pass,
  .score-fail {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
  }

  .score-used code {
    font-size: 0.8rem;
  }

  .score-pass {
    color: var(--status-success);
  }

  .score-fail {
    color: var(--status-error);
    font-weight: 600; /* was 700 */
  }

  .score .checks {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.88rem;
  }

  .score .checks li {
    margin-bottom: 0.35rem;
  }

  /* A colophon: what the engine read, when, against which clock. Sourcing,
     not claim, so it takes the metadata face (§2.7, NYT's credit line). */
  .provenance {
    margin: 0.8rem 0 0;
    font-family: var(--machine-face);
    font-size: var(--machine-size); /* 13px */
    letter-spacing: var(--machine-track);
    line-height: var(--machine-lh);
    font-variant-numeric: tabular-nums;
    /* [computed] #525252 on #ffffff = 7.81:1 */
    color: var(--fg-muted);
  }

  .provenance + .provenance {
    margin-top: 0.3rem;
  }

  /* ---------- field table ---------- */

  .fields .toggle {
    margin-right: 0.35rem;
    /* 24x24, not 20x20 — nice-to-have #11, WCAG 2.5.8 target-size minimum
       for the box itself. */
    width: 24px;
    height: 24px;
    accent-color: var(--cds-text-primary);
  }

  .fields .toggle-label {
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* hit target */
    font-size: 16px;
    cursor: pointer;
  }

  /* `.fields` prefix, not the bare `.field-table td:first-child` this used
     to be: global.css declares the identical selector with
     `white-space: nowrap` and its bundle is linked LAST, so at equal
     specificity the override silently lost and every field key in the
     table was still unbreakable. Verified against the built CSS. */
  .fields .field-table td:first-child {
    white-space: normal;
  }

  .field-table td:nth-child(3) code {
    word-break: break-word;
  }

  /* The ten group bands are the table's real navigation; they take the
     label primitive (spec §6.7). */
  .field-table .group-row th {
    background: var(--bg-inset); /* #e0e0e0 — a band inside the machine's own table */
    /* briefgateway.css zeroes the left padding on every cell so the table
       reads as ruled columns rather than a boxed grid; the group band is
       the one filled cell on the page and needs its inset back. */
    padding: 10px 12px;
    font-family: var(--machine-face);
    font-size: 13px;
    font-weight: var(--machine-weight); /* 400 */
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    /* [computed] #525252 on #e0e0e0 = 5.92:1 */
    color: var(--fg-muted);
  }

  .field-table tr[data-label='missing'] td {
    color: var(--fg-muted);
  }

  #hide-missing:checked ~ .comparison tr[data-label='missing'] {
    display: none;
  }

  .quote,
  .rule,
  .note {
    display: block;
    margin-top: 0.2rem;
  }

  /* `.rule` is the derivation rule that fired — the program explaining
     itself — so it is in the machine face. `.note` is an editorial aside
     written by a human and stays in the reading face (§2.7): the split is
     only useful if it is applied to the actual boundary. */
  .rule {
    font-family: var(--machine-face);
    font-size: var(--machine-size); /* 13px */
    letter-spacing: var(--machine-track);
    line-height: var(--machine-lh);
  }

  .note {
    font-size: 0.85rem;
  }

  .quote {
    font-family: var(--machine-face);
    font-size: 14px; /* Code 01 — was 0.78rem (12.5px) */
    letter-spacing: 0.16px;
    /* [computed] #525252 on #ffffff = 7.81:1 · on #f4f4f4 = 7.10:1 */
    color: var(--fg-muted);
  }

  /* The underline marks the exact characters the extractor read — a machine
     classification of the reader's own text, so it takes --status-info. */
  .quote mark {
    background: transparent;
    color: var(--fg);
    padding: 0;
    box-shadow: inset 0 -2px 0 var(--status-info);
  }

  .note {
    color: var(--fg-muted);
    font-style: italic;
  }

  /* ---------- assumptions ---------- */

  /* An assumption is an OFFER the reader acts on, not output the program
     has produced — it has a checkbox, and nothing in it reaches a payload
     until a human ticks it. So it does not take the machine ground (THE
     GROUND LAW, token file): it was an #f4f4f4 rounded box wrapping the
     section's own h2 and intro prose, which also meant the section rule
     landed on the box's edge. The list is now bracketed by two column
     hairlines with a hairline between each offer — the same apparatus
     treatment the page tail uses.
     (Two passes ago this was 1px DASHED, the only dashed box on the site;
     dashed reads as unfinished. That is still true and still fixed.) */
  .assumptions {
    border: none;
    background: none;
    border-radius: 0;
    padding: 0;
  }

  .assumption {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.2rem 0.6rem;
    padding: 12px 0;
    border-top: 1px solid var(--rule-column);
  }

  .assumptions > .assumption:last-of-type {
    border-bottom: 1px solid var(--rule-column);
  }

  /* It IS a field: accepting an assumption is data entry. */
  .assumption:focus-within {
    box-shadow: var(--field-shadow-focus);
    border-radius: var(--site-radius);
  }

  .assumption label {
    align-self: baseline;
    display: flex;
    align-items: center;
    min-height: 44px; /* hit target */
  }

  .assumption .accept {
    /* 24x24, not 20x20 — nice-to-have #11, WCAG 2.5.8 target-size minimum. */
    width: 24px;
    height: 24px;
    accent-color: var(--cds-text-primary);
  }

  .assumption .rule,
  .assumption .assumption-state {
    grid-column: 2;
    margin: 0;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }

  .assumption.is-on .assumption-state {
    color: var(--status-warning);
    font-weight: 600; /* was 700 */
  }

  /* ---------- blockers ---------- */

  ul.blockers {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }

  ul.blockers li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.92rem;
  }

  /* ---------- output panes ---------- */

  .panes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 24px;
  }

  .pane {
    min-width: 0;
  }

  .pane-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: baseline;
    justify-content: space-between;
  }

  .pane-head h3 {
    margin: 0;
  }

  /* Caption for the payload below it — terse, at the figure, in the
     metadata face (§2.13 + §2.7). */
  .pane-note {
    font-family: var(--machine-face);
    font-size: var(--machine-size); /* 13px */
    letter-spacing: var(--machine-track);
    line-height: var(--machine-lh);
    /* [computed] #525252 on #ffffff = 7.81:1 */
    color: var(--fg-muted);
    margin: 0.3rem 0 0.5rem;
  }

  /* The two payload panes are esc()'d plain text, not Shiki output, so they
     carry no syntax colour — that would need a JS edit this pass must not
     make. `--site-radius` here overrides global.css's plain `pre` rule
     (var(--code-radius, var(--radius-2)), i.e. 2px) at equal-or-higher
     specificity. */
  .pane pre {
    background: var(--bg-subtle);
    border: none;
    border-radius: var(--site-radius);
    padding: 16px;
    max-height: 26rem;
    overflow: auto;
  }

  ul.omitted {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
  }

  ul.omitted li {
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--border);
  }

  details > summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    cursor: pointer;
    font-size: 16px;
    color: var(--fg);
  }

  /* ---------- status — the Configure -> Monitor boundary (spec §6.4) ----------
     The engine reporting on what it just did, so it is the machine's voice
     (§2.7) — and that is now the whole boundary marker. The rule it used to
     carry is gone: the very next thing on the page is "The score", whose
     own sheet rule draws the boundary, and two hairlines 24px apart is
     rhythm noise, not hierarchy. The portfolio's only >2px left rule
     (ruling 5) and the 700 weight were deleted in an earlier pass and stay
     deleted. */
  .results-status {
    margin: var(--break-space-above) 0 0;
    max-width: var(--measure);
    font-family: var(--machine-face);
    font-size: 1rem; /* 16px */
    font-weight: var(--machine-weight); /* 400 */
    line-height: var(--machine-lh);
    letter-spacing: var(--machine-track);
    /* [computed] #161616 on #ffffff = 18.10:1 */
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  /* The last section on the page needs a floor under it; every other
     region's space comes from the next break. */
  .panel[aria-labelledby='h-next'] {
    margin-bottom: var(--break-space-above);
  }

  /* was var(--accent-bright) = #525252. Keep :focus, not :focus-visible —
     the script focuses this container programmatically and Chrome will not
     match :focus-visible for a script-driven focus(). */
  #results:focus {
    outline: 2px solid var(--cds-text-primary);
    outline-offset: 4px;
  }
</style>

<script>
  /**
   * The client half. Imports the same engine the frontmatter ran at build time,
   * so the browser reproduces the server's output for the server's input.
   */
  import { analyze, FIELDS } from '@agenticbrief/brief-engine'
  import type { EngineAnalysis, FieldValue, Span } from '@agenticbrief/brief-engine'

  /* ==================================================================== *
   * MIRRORED RENDERER — the same code as the copy in the frontmatter above.
   * Change one, change both. Nothing inside a template literal is indented,
   * so the two copies emit identical HTML.
   * ==================================================================== */

  interface Ui {
    accepted: readonly string[]
    hideMissing: boolean
  }

  const GROUPS: ReadonlyArray<readonly [string, string]> = [
    ['identity', 'Identity'],
    ['timing', 'Timing'],
    ['budget', 'Budget'],
    ['geo', 'Geography'],
    ['inventory', 'Inventory'],
    ['creative', 'Creative'],
    ['audience', 'Audience'],
    ['measurement', 'Measurement'],
    ['safety', 'Brand safety'],
    ['governance', 'Governance'],
  ]

  const ESCAPES: Record<string, string> = {
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  }

  /** Everything interpolated into HTML goes through this, engine text included. */
  function esc(value: unknown): string {
    return String(value ?? '').replace(/[&<>"']/g, (c) => ESCAPES[c] as string)
  }

  function cut(text: string, limit: number): string {
    return text.length > limit ? `${text.slice(0, limit - 1)}…` : text
  }

  /** A field value as one line. Objects stay JSON so nothing is paraphrased. */
  function fmtValue(value: unknown): string {
    if (value === undefined || value === null) return ''
    if (typeof value === 'string') return value
    if (typeof value === 'number' || typeof value === 'boolean') return String(value)
    return JSON.stringify(value)
  }

  function chip(label: string): string {
    return `<span class="chip chip-${esc(label)}">${esc(label)}</span>`
  }

  function fieldLabel(key: string): string {
    return FIELDS.find((f) => f.key === key)?.label ?? key
  }

  function fieldOrder(key: string): number {
    const i = FIELDS.findIndex((f) => f.key === key)
    return i === -1 ? FIELDS.length : i
  }

  /** The source span, quoted with enough either side to recognise it. */
  function evidence(input: string, spans: readonly Span[]): string {
    return spans
      .slice(0, 3)
      .map((s) => {
        const before = input.slice(Math.max(0, s.start - 24), s.start)
        const after = input.slice(s.end, Math.min(input.length, s.end + 24))
        const head = s.start > 0 ? '…' : ''
        const tail = s.end < input.length ? '…' : ''
        return `<span class="quote">${head}${esc(before)}<mark>${esc(cut(s.text, 90))}</mark>${esc(after)}${tail}</span>`
      })
      .join('')
  }

  function metaLine(a: EngineAnalysis): string {
    const ref = a.meta.options.now
    const when = ref
      ? `relative dates resolved against ${esc(new Date(ref).toISOString().slice(0, 10))}`
      : 'no reference date supplied, so relative dates were left unresolved'
    return (
      `AdCP schema ${esc(a.meta.adcpVersion)} · ` +
      `buying mode <code>${esc(a.meta.options.buyingMode)}</code> · ` +
      when
    )
  }

  /** The sentence the live region announces. */
  function statusLine(a: EngineAnalysis): string {
    const t = a.scores.transactable
    const e = a.scores.expressive
    const blocking = a.blockers.filter((b) => b.severity === 'blocks').length
    return (
      `Scored. Transactable ${t.score} of ${t.of}. Expressive ${e.score} of ${e.of}. ` +
      `${a.blockers.length} things a seller will guess or drop, ${blocking} of them blocking.`
    )
  }

  function renderScores(a: EngineAnalysis): string {
    const t = a.scores.transactable
    const e = a.scores.expressive
    const failed = t.checks.filter((c) => !c.passed)
    const unused = e.of - e.score
    return `<section class="panel" aria-labelledby="h-score">
<h2 id="h-score">The score</h2>
<div class="scores">
<div class="score" data-pass="${t.ok}">
<p class="score-name">Transactable <span class="score-kind">gate</span></p>
<p class="score-value"><strong>${t.score}</strong> of ${t.of}</p>
<p class="score-what">AAMP <code>CampaignBrief</code>&#39;s eight required fields, plus a <code>budget_pct</code> on every channel allocation, plus one check that the AdCP <code>get_products</code> request validates. Counted against the emitted payloads, not your sentences.</p>
${
  failed.length === 0
    ? `<p class="score-pass">All ${t.of} checks pass.</p>`
    : `<p class="score-fail">${failed.length} fail:</p><ul class="checks">${failed
        .map((c) => `<li><strong>${esc(c.label)}</strong> — ${esc(c.reason)}</li>`)
        .join('')}</ul>`
}
</div>
<div class="score">
<p class="score-name">Expressive <span class="score-kind">coverage, not a target</span></p>
<p class="score-value"><strong>${e.score}</strong> of ${e.of}</p>
<p class="score-what">AdCP <code>filters.*</code> fields your brief populates. The other ${unused} go to the seller empty, so nothing in them is filtered on. Every populated filter is a hard constraint that deletes products: <a href="/spec/brief-vs-filters/">brief vs filters</a> has the routing rule.</p>
${
  e.score === 0
    ? '<p class="score-fail">No filter is populated. The seller gets the brief string and nothing to filter on.</p>'
    : `<p class="score-used">Populated: ${e.used.map((u) => `<code>${esc(u)}</code>`).join(' ')}</p>`
}
</div>
</div>
<p class="provenance">${metaLine(a)}</p>
<p class="provenance">Relative dates use today's date. Write absolute dates for a result that holds next week.</p>
</section>`
  }

  function fieldRow(a: EngineAnalysis, key: string): string {
    const def = FIELDS.find((f) => f.key === key)
    if (!def) return ''
    const fv: FieldValue<unknown> = a.fields[key] ?? { label: 'missing', spans: [] }
    const spans = fv.spans ?? []
    const value =
      fv.label === 'missing'
        ? '<span class="cell-empty">no value</span>'
        : `<code>${esc(cut(fmtValue(fv.value), 140))}</code>`
    let why = ''
    if (fv.label === 'stated') {
      why = evidence(a.input, spans)
    } else if (fv.label === 'derived' || fv.label === 'assumed') {
      why = `<span class="rule">${esc(fv.rule ?? '')}</span>${
        spans.length > 0 ? evidence(a.input, spans) : ''
      }`
    } else {
      why = `<span class="muted">${esc(def.consequence)}</span>`
    }
    if (fv.note) why += `<span class="note">${esc(fv.note)}</span>`
    return `<tr data-label="${esc(fv.label)}">
<td><code>${esc(def.key)}</code></td>
<td>${esc(def.label)}</td>
<td>${value}</td>
<td>${chip(fv.label)}</td>
<td>${why}</td>
</tr>`
  }

  function renderFields(a: EngineAnalysis, ui: Ui): string {
    const counts = a.scores.labels
    const body = GROUPS.map(([group, name]) => {
      const keys = FIELDS.filter((f) => f.group === group).map((f) => f.key)
      return `<tbody><tr class="group-row"><th colspan="5" scope="colgroup">${esc(name)}</th></tr>${keys
        .map((k) => fieldRow(a, k))
        .join('')}</tbody>`
    }).join('')
    return `<section class="panel fields" aria-labelledby="h-fields">
<h2 id="h-fields">Every field, and where it came from</h2>
<p>${counts.stated} stated, ${counts.derived} derived, ${counts.assumed} assumed, ${counts.missing} missing, of ${a.scores.fieldsTotal} the two protocols can express between them.</p>
<input type="checkbox" id="hide-missing" class="toggle"${ui.hideMissing ? ' checked' : ''} />
<label for="hide-missing" class="toggle-label">Hide the fields with no value</label>
<figure class="comparison">
<table class="field-table">
<caption>One row per concept, including the ones this brief says nothing about.</caption>
<thead><tr><th scope="col">Field</th><th scope="col">What it is</th><th scope="col">Value</th><th scope="col">Label</th><th scope="col">Evidence</th></tr></thead>
${body}
</table>
</figure>
</section>`
  }

  function renderAssumptions(a: EngineAnalysis, ui: Ui): string {
    const keys = [...new Set([...Object.keys(a.offered), ...ui.accepted])].sort(
      (x, y) => fieldOrder(x) - fieldOrder(y),
    )
    const applied = keys.filter((k) => ui.accepted.includes(k)).length
    const items = keys
      .map((key) => {
        const fv = a.offered[key] ?? a.fields[key]
        if (!fv) return ''
        const on = ui.accepted.includes(key)
        return `<div class="assumption${on ? ' is-on' : ''}">
<input type="checkbox" class="accept" id="assume-${esc(key)}" data-assume="${esc(key)}"${on ? ' checked' : ''} />
<label for="assume-${esc(key)}"><strong>${esc(fieldLabel(key))}</strong> = <code>${esc(cut(fmtValue(fv.value), 140))}</code></label>
<p class="rule">${esc(fv.rule ?? '')}</p>
<p class="assumption-state">${
          on
            ? 'Accepted. It is in both payloads below, labelled assumed everywhere it appears.'
            : 'Not accepted, so it is in nothing below.'
        }</p>
</div>`
      })
      .join('')
    return `<section class="panel assumptions" aria-labelledby="h-assume">
<h2 id="h-assume">Assumptions — ${applied === 0 ? 'none applied' : `${applied} applied`}</h2>
<p>Values the engine could pick and has not. Accept one and both payloads are emitted again with it in, labelled <code>assumed</code>. Accept nothing and nothing here reaches a seller. Scoring a brief again clears every acceptance.</p>
${
  keys.length === 0
    ? '<p class="muted">Nothing to offer for this brief. Every value below came from your words.</p>'
    : items
}
<noscript><p class="muted">JavaScript is off, so these boxes do nothing and no assumption is applied.</p></noscript>
</section>`
  }

  function renderBlockers(a: EngineAnalysis): string {
    const item = (b: EngineAnalysis['blockers'][number]): string =>
      `<li><span class="chip chip-sev-${esc(b.severity)}">${esc(b.severity)}</span> <strong>${esc(
        b.field ? fieldLabel(b.field) : 'The request',
      )}</strong> — ${esc(b.detail)} <span class="muted">${esc(b.consequence)}</span></li>`
    const of = (severity: string) => a.blockers.filter((b) => b.severity === severity)
    const blocks = of('blocks')
    const drops = of('drops')
    const degrades = of('degrades')
    return `<section class="panel" aria-labelledby="h-blockers">
<h2 id="h-blockers">What a seller will guess or drop</h2>
<p>${a.blockers.length} in all: ${blocks.length} stop the brief constructing, ${drops.length} are read here and travel in neither payload, ${degrades.length} leave a field empty for the seller to fill however it likes.</p>
${
  blocks.length > 0
    ? `<h3>Blocks — nothing ships</h3><ul class="blockers">${blocks.map(item).join('')}</ul>`
    : ''
}
${
  drops.length > 0
    ? `<h3>Drops — read here, carried in neither payload</h3><ul class="blockers">${drops
        .map(item)
        .join('')}</ul>`
    : ''
}
${
  degrades.length > 0
    ? `<details><summary>Degrades — ${degrades.length} fields the seller fills for you</summary><ul class="blockers">${degrades
        .map(item)
        .join('')}</ul></details>`
    : ''
}
</section>`
  }

  function renderPane(opts: {
    id: string
    heading: string
    note: string
    payload: unknown
    omitted: EngineAnalysis['omitted']['adcp']
  }): string {
    const json = JSON.stringify(opts.payload, null, 2)
    return `<section class="pane" aria-labelledby="h-${esc(opts.id)}">
<div class="pane-head">
<h3 id="h-${esc(opts.id)}">${opts.heading}</h3>
<button type="button" class="copy" data-copy="${esc(opts.id)}-json">Copy ${esc(opts.id.toUpperCase())} JSON</button>
</div>
<p class="pane-note">${opts.note}</p>
<pre id="${esc(opts.id)}-json"><code>${esc(json)}</code></pre>
<details>
<summary>${opts.omitted.length} fields left out of this payload, and what that costs</summary>
<ul class="omitted">${opts.omitted
      .map(
        (o) =>
          `<li><code>${esc(o.field)}</code> ${chip(o.label)} <span class="muted">${esc(o.reason)}</span></li>`,
      )
      .join('')}</ul>
</details>
</section>`
  }

  function renderOutputs(a: EngineAnalysis): string {
    return `<section class="panel" aria-labelledby="h-out">
<h2 id="h-out">What gets sent</h2>
<div class="panes">
${renderPane({
  id: 'adcp',
  heading: 'AdCP <code>get_products</code> request',
  note: 'Structured filters plus the residual prose, which AdCP carries as one unvalidated string.',
  payload: a.adcp,
  omitted: a.omitted.adcp,
})}
${renderPane({
  id: 'aamp',
  heading: 'AAMP <code>CampaignBrief</code>',
  note: 'IAB Tech Lab buyer agent, models/campaign_brief.py — eight required fields, cross-field validators.',
  payload: a.aamp,
  omitted: a.omitted.aamp,
})}
</div>
</section>`
  }

  function renderResults(a: EngineAnalysis, ui: Ui): string {
    return (
      renderScores(a) +
      renderFields(a, ui) +
      renderAssumptions(a, ui) +
      renderBlockers(a) +
      renderOutputs(a)
    )
  }

  /* ==================================================================== *
   * END MIRRORED RENDERER
   * ==================================================================== */

  const input = document.getElementById('brief-input') as HTMLTextAreaElement | null
  const results = document.getElementById('results')
  const status = document.getElementById('score-status')
  const scoreButton = document.getElementById('score')
  const restoreButton = document.getElementById('restore')

  if (input && results && status && scoreButton) {
    /** The brief the rendered results belong to, and the UI state over it. */
    const example = input.value
    let text = input.value
    let accepted: string[] = []
    let hideMissing = false
    /** The one clock read in this page. The engine never reads one. */
    const REFERENCE_DATE = new Date()

    /**
     * Re-analyze and repaint. `accepted` is passed to the engine, which is the
     * only route by which an assumed value reaches a payload — the UI cannot
     * smuggle one in, because it never writes a value, only a key.
     *
     * `focusKey` puts the caret back on the checkbox that caused the repaint;
     * without it a keyboard user is returned to the top of the document every
     * time they accept an assumption.
     */
    const paint = (focusKey?: string): void => {
      // The reference date is read ONCE, here in the page, and passed in. The
      // engine reads no clock: omit `now` and 'next quarter' stays missing.
      // Reading it once per session also means the same paste analyses the
      // same way for as long as the tab is open.
      const a = analyze(text, { assume: accepted, now: REFERENCE_DATE })
      results.innerHTML = renderResults(a, { accepted, hideMissing })
      status.textContent = statusLine(a)
      if (focusKey) {
        const box = results.querySelector<HTMLInputElement>(
          `input[data-assume="${CSS.escape(focusKey)}"]`,
        )
        box?.focus()
      }
    }

    scoreButton.addEventListener('click', () => {
      text = input.value
      // A new brief invalidates every acceptance: the offers are recomputed
      // from the new words, and silently carrying an accept across inputs is
      // the same defect as inventing the value in the first place.
      accepted = []
      paint()
      results.focus()
    })

    restoreButton?.addEventListener('click', () => {
      input.value = example
      input.focus()
    })

    // Ctrl/Cmd + Enter from the textarea scores it.
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && (event.metaKey || event.ctrlKey)) {
        event.preventDefault()
        scoreButton.dispatchEvent(new MouseEvent('click'))
      }
    })

    // Delegated, because every control below is replaced on each repaint.
    results.addEventListener('change', (event) => {
      const target = event.target as HTMLElement | null
      if (!(target instanceof HTMLInputElement)) return
      if (target.id === 'hide-missing') {
        hideMissing = target.checked
        return
      }
      const key = target.dataset.assume
      if (!key) return
      accepted = target.checked ? [...accepted, key] : accepted.filter((k) => k !== key)
      paint(key)
    })

    results.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-copy]')
      if (!button) return
      const pre = document.getElementById(button.dataset.copy ?? '')
      if (!pre) return
      // Remembered on the element, so a second click while the button still
      // says "Copied" restores the real label rather than that one.
      if (!button.dataset.label) button.dataset.label = button.textContent ?? 'Copy'
      const label = button.dataset.label
      const say = (message: string, ms: number): void => {
        button.textContent = message
        window.setTimeout(() => {
          button.textContent = label
          delete button.dataset.state
        }, ms)
      }
      // Undefined on an insecure origin, where reading it is fine and calling
      // it throws synchronously.
      if (!navigator.clipboard) {
        say('Select the JSON and copy it — no clipboard here', 2600)
        return
      }
      navigator.clipboard.writeText(pre.textContent ?? '').then(
        () => {
          button.dataset.state = 'done'
          say('Copied', 1600)
        },
        () => say('Select the JSON and copy it — the clipboard was refused', 2600),
      )
    })
  }
</script>
