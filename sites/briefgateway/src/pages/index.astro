---
import { getEntry, render } from 'astro:content'
import DocPage from '@agenticbrief/shared-ui/DocPage.astro'
import { siteUrl } from '@agenticbrief/shared-ui/sites'
import { graph, softwareApplicationNode } from '@agenticbrief/seo/schema'

const entry = await getEntry('briefs', 'index-generator')
if (!entry) throw new Error('content/briefs/index-generator.md is missing')
const { Content } = await render(entry)
const BASE = siteUrl('briefgateway')
---

<DocPage
  site="briefgateway"
  entry={entry}
  path="/"
  technical={false}
  breadcrumbs={[{ name: 'Brief Gateway', url: `${BASE}/` }]}
>
  <Content />
</DocPage>
