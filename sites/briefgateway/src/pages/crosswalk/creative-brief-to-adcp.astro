---
import { getEntry, render } from 'astro:content'
import DocPage from '@agenticbrief/shared-ui/DocPage.astro'
import { siteUrl } from '@agenticbrief/shared-ui/sites'
import IllustrationPlaceholder from '@agenticbrief/shared-ui/IllustrationPlaceholder.astro'
import { illustrationPrompt } from '../../lib/illustration-style'
import '../../styles/briefgateway.css'

const entry = await getEntry('comparisons', 'creative-brief-to-adcp')
if (!entry) throw new Error('content/comparisons/creative-brief-to-adcp.md is missing')
const { Content } = await render(entry)
const BASE = siteUrl('briefgateway')

// New catalogue entry, appended to this site's own prompt file (not the
// shared /srv/ws/out/illustration-prompts.md — see
// /srv/ws/out/illustration-prompts-briefgateway.md).
const FAN_OUT_PROMPT = illustrationPrompt(`
Fan-out diagram, one source on the left, five destinations stacked in a
vertical column on the right. LEFT: a single RECTANGLE containing five
short horizontal lines of varying length (prose wireframe, not a form),
label beneath it "Creative brief". RIGHT, five separate RECTANGLES stacked
top to bottom with equal gaps, each holding one line of monospace-style
label text, in this order: "filters.* (get_products)", "brief string
(get_products)", "brand.json (you host it)", "package fields
(create_media_buy)", "message (build_creative)". ARROWS: five straight
lines from the right edge of the left rectangle to the left edge of each
of the five rectangles, fanning out. No arrow labels. The accent highlight
(#0057c2) is on the THIRD rectangle's border only, "brand.json (you host
it)" — it is the one destination that is not a field on a request. All
other strokes near-black #161616. No captions in the image.
`)
---

<DocPage
  site="briefgateway"
  entry={entry}
  path="/crosswalk/creative-brief-to-adcp/"
  technical={false}
  breadcrumbs={[
    { name: 'Brief Gateway', url: `${BASE}/` },
    { name: 'Creative brief to AdCP', url: `${BASE}/crosswalk/creative-brief-to-adcp/` },
  ]}
>
  {
    /* DEV-ONLY (user decision): production ships clean, with no visible
       placeholder box. The slot still renders under `astro dev` so the
       reserved space is visible while designing, and the prompt stays
       catalogued in /srv/ws/out/illustration-prompts-briefgateway.md. */
    import.meta.env.DEV && (
      <div class="illustration-cap-640">
        <IllustrationPlaceholder
          prompt={FAN_OUT_PROMPT}
          alt="Diagram of one creative brief fanning out into five separate destinations across three AdCP requests and a self-hosted brand file, with the self-hosted file highlighted."
          slug="briefgateway/crosswalk-creative-brief-to-adcp/brief-splits-five-ways"
          ratio="4 / 3"
        />
      </div>
    )
  }
  <Content />
</DocPage>
