---
import { getEntry, render } from 'astro:content'
import DocPage from '@agenticbrief/shared-ui/DocPage.astro'
import { siteUrl } from '@agenticbrief/shared-ui/sites'
import '../../styles/briefgateway.css'

const entry = await getEntry('comparisons', 'adcp-brief-vs-aamp-campaign-brief')
if (!entry) throw new Error('content/comparisons/adcp-brief-vs-aamp-campaign-brief.md is missing')
const { Content } = await render(entry)
const BASE = siteUrl('briefgateway')
---

<DocPage
  site="briefgateway"
  entry={entry}
  path="/compare/adcp-brief-vs-aamp-campaign-brief/"
  technical={false}
  breadcrumbs={[
    { name: 'Brief Gateway', url: `${BASE}/` },
    {
      name: 'AdCP brief vs AAMP CampaignBrief',
      url: `${BASE}/compare/adcp-brief-vs-aamp-campaign-brief/`,
    },
  ]}
>
  <Content />
</DocPage>
